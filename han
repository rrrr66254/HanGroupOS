# ── han start ─────────────────────────────────────────────────────────────────
cmd_start() {
  local DAEMON=false
  [[ "$1" == "--daemon" || "$1" == "-d" ]] && DAEMON=true

  if is_running "$HAN_PID_BACKEND" || is_running "$HAN_PID_FRONTEND"; then
    echo -e "${YELLOW}⚠ 서버가 이미 실행 중입니다. 'han status' 로 확인하세요.${NC}"
    exit 1
  fi

  if [ "$DAEMON" = true ]; then
    echo -e "${BOLD}HAN Group OS 백그라운드 시작 중...${NC}"
    echo ""

    cd "$HAN_DIR/backend"
    [ ! -d "venv" ] && python3 -m venv venv
    source venv/bin/activate
    pip install -q -r requirements.txt
    nohup uvicorn main:app --host 0.0.0.0 --port 8000 \
      > "$HAN_LOG_DIR/backend.log" 2>&1 &
    echo $! > "$HAN_PID_BACKEND"
    echo -e "  ${GREEN}✓ 백엔드 시작${NC} (PID: $(cat "$HAN_PID_BACKEND"))"

    cd "$HAN_DIR/frontend"
    [ ! -d "node_modules" ] && npm install --silent
    nohup npm run dev \
      > "$HAN_LOG_DIR/frontend.log" 2>&1 &
    echo $! > "$HAN_PID_FRONTEND"
    echo -e "  ${GREEN}✓ 프론트엔드 시작${NC} (PID: $(cat "$HAN_PID_FRONTEND"))"

    sleep 2
    echo ""
    echo -e "${GREEN}════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  ✅ HAN Group OS v${HAN_VERSION} 백그라운드 실행 중${NC}"
    echo ""
    echo "  🌐 앱:  http://localhost:5173"
    echo "  🔧 API: http://localhost:8000"
    echo ""
    echo "  han stop    — 종료    han status — 상태 확인"
    echo "  han logs    — 로그    han open   — 브라우저"
    echo -e "${GREEN}════════════════════════════════════════════════${NC}"
  else
    exec "$HAN_DIR/start.sh"
  fi
}

# ── han stop ──────────────────────────────────────────────────────────────────
cmd_stop() {
  local STOPPED=false

  if is_running "$HAN_PID_BACKEND"; then
    kill "$(cat "$HAN_PID_BACKEND")" 2>/dev/null \
      && echo -e "  ${GREEN}✓ 백엔드 종료됨${NC}" \
      || echo -e "  ${RED}✗ 백엔드 종료 실패${NC}"
    rm -f "$HAN_PID_BACKEND"
    STOPPED=true
  fi

  if is_running "$HAN_PID_FRONTEND"; then
    kill "$(cat "$HAN_PID_FRONTEND")" 2>/dev/null \
      && echo -e "  ${GREEN}✓ 프론트엔드 종료됨${NC}" \
      || echo -e "  ${RED}✗ 프론트엔드 종료 실패${NC}"
    rm -f "$HAN_PID_FRONTEND"
    STOPPED=true
  fi

  if [ "$STOPPED" = false ]; then
    echo -e "${YELLOW}⚠ 백그라운드에서 실행 중인 서버가 없습니다.${NC}"
    echo "  (포그라운드 실행 중이라면 Ctrl+C로 종료하세요)"
  fi
}

# ── han restart ───────────────────────────────────────────────────────────────
cmd_restart() {
  echo "서버 재시작 중..."
  cmd_stop
  sleep 1
  cmd_start "--daemon"
}

# ── han status ────────────────────────────────────────────────────────────────
cmd_status() {
  echo ""
  echo -e "${BOLD}HAN Group OS 상태${NC}"
  echo ""

  for spec in "8000:백엔드:$HAN_PID_BACKEND" "5173:프론트엔드:$HAN_PID_FRONTEND"; do
    local port="${spec%%:*}"; spec="${spec#*:}"
    local label="${spec%%:*}"
    local pid_file="${spec##*:}"

    if is_running "$pid_file"; then
      echo -e "  $label : ${GREEN}● 실행 중${NC} (PID: $(cat "$pid_file")) — http://localhost:$port"
    elif port_in_use "$port"; then
      echo -e "  $label : ${GREEN}● 실행 중${NC} (포그라운드) — http://localhost:$port"
    else
      echo -e "  $label : ${RED}○ 중지됨${NC}"
    fi
  done

  echo ""
  echo "  설치 경로 : $HAN_DIR"
  echo "  CLI 버전  : v${HAN_VERSION}"

  if command -v git &>/dev/null && [ -d "$HAN_DIR/.git" ]; then
    local commit
    commit=$(git -C "$HAN_DIR" rev-parse --short HEAD 2>/dev/null || echo "알 수 없음")
    echo "  커밋      : $commit"
  fi

  if [ -f "$HAN_DIR/backend/.env" ]; then
    local provider
    provider=$(grep "^DEFAULT_PROVIDER=" "$HAN_DIR/backend/.env" | cut -d= -f2)
    echo "  AI 프로바이더 : ${provider:-미설정}"
  fi

  # ─ DB 상태 ──────────────────────────────────────────────────────────────────
  echo ""
  local DB_PATH="$HAN_DIR/backend/han_group.db"
  if [ -f "$DB_PATH" ]; then
    local db_size table_count
    db_size=$(du -sh "$DB_PATH" 2>/dev/null | cut -f1)
    # SQLite 테이블 수 조회 (venv python 사용)
    local VENV_PYTHON="$HAN_DIR/backend/venv/bin/python"
    if [ -f "$VENV_PYTHON" ]; then
      table_count=$(HAN_DIR="$HAN_DIR" "$VENV_PYTHON" -c "
import sqlite3, os
conn = sqlite3.connect(os.path.join(os.environ['HAN_DIR'],'backend','han_group.db'))
n = conn.execute(\"SELECT count(*) FROM sqlite_master WHERE type='table'\").fetchone()[0]
print(n)
conn.close()
" 2>/dev/null || echo "?")
    else
      table_count="?"
    fi
    echo -e "  ${BOLD}DB 상태${NC}"
    echo "  ├ 파일  : $DB_PATH"
    echo "  ├ 크기  : $db_size"
    echo "  ├ 테이블: ${table_count}개"
    # 마지막 마이그레이션 백업
    local last_mig
    last_mig=$(ls -t "$HAN_BACKUP_DIR"/han_group_before_migrate_*.db 2>/dev/null | head -1)
    if [ -n "$last_mig" ]; then
      local mig_time
      mig_time=$(date -r "$last_mig" "+%Y-%m-%d %H:%M:%S" 2>/dev/null \
                 || stat -c "%y" "$last_mig" 2>/dev/null | cut -d. -f1)
      echo "  └ 마지막 migrate: $mig_time"
    else
      echo "  └ 마지막 migrate: 없음 (han migrate 로 초기화)"
    fi
  else
    echo -e "  ${YELLOW}⚠ DB 없음${NC} — han start --daemon 실행 시 자동 생성됩니다."
  fi
  echo ""
}

# ── han logs ──────────────────────────────────────────────────────────────────
cmd_logs() {
  local LINES=50
  local SINCE=""
  local GREP_PATTERN=""
  local FOLLOW=false
  local TARGET="all"

  # 인자 파싱 (--옵션 vs backend/frontend 위치 인자)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lines)    LINES="${2:-50}"; shift 2 ;;
      --since)    SINCE="${2:-}";   shift 2 ;;
      --grep)     GREP_PATTERN="${2:-}"; shift 2 ;;
      --follow|-f) FOLLOW=true; shift ;;
      backend|frontend) TARGET="$1"; shift ;;
      *) shift ;;
    esac
  done

  # 로그 파일 목록 결정
  local FILES=()
  case "$TARGET" in
    backend)  [ -f "$HAN_LOG_DIR/backend.log"  ] && FILES+=("$HAN_LOG_DIR/backend.log")  ;;
    frontend) [ -f "$HAN_LOG_DIR/frontend.log" ] && FILES+=("$HAN_LOG_DIR/frontend.log") ;;
    *)
      [ -f "$HAN_LOG_DIR/backend.log"  ] && FILES+=("$HAN_LOG_DIR/backend.log")
      [ -f "$HAN_LOG_DIR/frontend.log" ] && FILES+=("$HAN_LOG_DIR/frontend.log")
      # han.log (백엔드 RotatingFileHandler 로그)
      [ -f "$HAN_DIR/han.log" ] && FILES+=("$HAN_DIR/han.log")
      ;;
  esac

  if [ ${#FILES[@]} -eq 0 ]; then
    echo -e "${YELLOW}로그 없음. 'han start --daemon' 또는 'han start'으로 실행하면 기록됩니다.${NC}"
    return 0
  fi

  # --follow 모드
  if $FOLLOW; then
    echo -e "${CYAN}[로그 실시간] Ctrl+C로 종료${NC}"
    if [ -n "$GREP_PATTERN" ]; then
      tail -f "${FILES[@]}" | grep --color=auto -i "$GREP_PATTERN"
    else
      tail -f "${FILES[@]}"
    fi
    return
  fi

  # --since 모드: N시간/분 전 이후 로그 필터
  if [ -n "$SINCE" ]; then
    local MINUTES=0
    if [[ "$SINCE" =~ ^([0-9]+)h$ ]]; then
      MINUTES=$(( ${BASH_REMATCH[1]} * 60 ))
    elif [[ "$SINCE" =~ ^([0-9]+)m$ ]]; then
      MINUTES="${BASH_REMATCH[1]}"
    elif [[ "$SINCE" =~ ^([0-9]+)$ ]]; then
      MINUTES="$SINCE"
    else
      echo -e "${RED}✗ 잘못된 --since 형식: $SINCE (예: 1h, 30m)${NC}"; exit 1
    fi
    local CUTOFF
    CUTOFF=$(date -d "-${MINUTES} minutes" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
             || date -v "-${MINUTES}M" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
             || date '+%Y-%m-%d %H:%M:%S')
    echo -e "${CYAN}[로그 — 최근 ${SINCE}] ${FILES[*]}${NC}"
    local COMBINED
    COMBINED=$(cat "${FILES[@]}" 2>/dev/null | awk -v cut="$CUTOFF" '$0 >= cut')
    if [ -n "$GREP_PATTERN" ]; then
      echo "$COMBINED" | grep --color=auto -i "$GREP_PATTERN" || echo -e "${YELLOW}패턴 '${GREP_PATTERN}' 없음${NC}"
    else
      echo "$COMBINED"
    fi
    return
  fi

  # 기본: 마지막 N줄
  echo -e "${CYAN}[로그 — 마지막 ${LINES}줄] ${FILES[*]}${NC}"
  if [ -n "$GREP_PATTERN" ]; then
    cat "${FILES[@]}" | tail -n "$LINES" | grep --color=auto -i "$GREP_PATTERN" || echo -e "${YELLOW}패턴 '${GREP_PATTERN}' 없음${NC}"
  else
    cat "${FILES[@]}" | tail -n "$LINES"
  fi
}

# ── han update ────────────────────────────────────────────────────────────────
cmd_update() {
  echo ""
  echo -e "${BOLD}han update — GitHub 업데이트 확인${NC}"
  echo ""

  if ! command -v git &>/dev/null; then
    echo -e "${RED}✗ git이 설치되지 않았습니다.${NC}"
    echo ""
    case $OS in
      macos)     echo "    brew install git" ;;
      wsl|linux) echo "    sudo apt install -y git" ;;
      *)         echo "    https://git-scm.com/downloads" ;;
    esac
    exit 1
  fi

  if [ ! -d "$HAN_DIR/.git" ]; then
    echo -e "${RED}✗ git 저장소가 아닙니다: $HAN_DIR${NC}"
    echo "  install.sh 로 설치한 경우에만 update가 동작합니다."
    exit 1
  fi

  cd "$HAN_DIR"

  # 네트워크 연결 확인
  echo -e "  ${DIM}원격 저장소 확인 중...${NC}"
  if ! git fetch origin master --quiet 2>/dev/null; then
    echo -e "${RED}✗ 원격 저장소에 연결할 수 없습니다. 네트워크를 확인하세요.${NC}"
    exit 1
  fi

  local LOCAL REMOTE BEHIND AHEAD
  LOCAL=$(git rev-parse HEAD)
  REMOTE=$(git rev-parse origin/master)
  BEHIND=$(git rev-list HEAD..origin/master --count 2>/dev/null || echo "0")
  AHEAD=$(git rev-list origin/master..HEAD --count 2>/dev/null || echo "0")

  if [ "$LOCAL" = "$REMOTE" ]; then
    echo -e "  ${GREEN}✓ 이미 최신 버전입니다.${NC}"
    echo ""
    echo -e "  ${DIM}현재 커밋: $(git rev-parse --short HEAD)${NC}"
    echo ""
    exit 0
  fi

  if [ "$BEHIND" -gt 0 ]; then
    echo -e "  ${CYAN}↓ 새 업데이트 ${BEHIND}개 커밋이 있습니다.${NC}"
    echo ""
    echo -e "${BOLD}  변경 내역:${NC}"
    git log HEAD..origin/master --oneline --no-walk=unsorted 2>/dev/null \
      | head -20 \
      | while IFS= read -r line; do
          echo "    $line"
        done
    echo ""
  fi

  if [ "$AHEAD" -gt 0 ]; then
    echo -e "  ${YELLOW}⚠ 로컬에 ${AHEAD}개의 커밋이 원격보다 앞서 있습니다.${NC}"
    echo ""
  fi

  # 업데이트 적용 여부 확인
  if [ -t 0 ]; then
    read -r -p "  업데이트를 적용하시겠습니까? (Y/n) > " APPLY
    APPLY="${APPLY:-Y}"
    if [[ ! "$APPLY" =~ ^[Yy]$ ]]; then
      echo "  취소됩니다."
      exit 0
    fi
  fi

  echo ""
  echo -e "  ${BOLD}업데이트 적용 중...${NC}"

  # 실행 중이면 먼저 종료
  if is_running "$HAN_PID_BACKEND" || is_running "$HAN_PID_FRONTEND"; then
    echo "  ✓ 실행 중인 서버 종료..."
    cmd_stop 2>/dev/null || true
    sleep 1
  fi

  # DB 자동 백업
  local DB_PATH="$HAN_DIR/backend/han_group.db"
  if [ -f "$DB_PATH" ]; then
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    cp "$DB_PATH" "$HAN_BACKUP_DIR/han_group_before_update_${ts}.db"
    echo -e "  ${GREEN}✓ DB 자동 백업됨${NC} (before_update_${ts}.db)"
  fi

  # git pull
  echo "  ✓ git pull origin master..."
  git pull origin master

  # ─ [1/3] 백엔드 의존성 ───────────────────────────────────────────────────
  echo ""
  echo -e "  ${CYAN}▸ [1/3] 백엔드 의존성 동기화...${NC}"
  cd "$HAN_DIR/backend"

  if [ ! -d "venv" ]; then
    echo -e "       venv 없음 — 새로 생성 중..."
    if python3 -m venv venv; then
      echo -e "  ${GREEN}  ✓ venv 생성됨${NC}"
    else
      echo -e "  ${RED}  ✗ venv 생성 실패 (python3 확인 필요)${NC}"
    fi
  fi

  if [ -d "venv" ]; then
    # shellcheck source=/dev/null
    source venv/bin/activate
    if pip install -q -r requirements.txt 2>/dev/null; then
      local pkg_count
      pkg_count=$(pip list 2>/dev/null | wc -l | tr -d ' ')
      echo -e "  ${GREEN}  ✓ 백엔드 패키지 동기화 완료${NC} (총 ${pkg_count}개)"
    else
      echo -e "  ${RED}  ✗ pip install 실패 — requirements.txt 확인 필요${NC}"
      echo "       pip install -r $HAN_DIR/backend/requirements.txt"
    fi
  fi

  # ─ [2/3] 프론트엔드 의존성 ───────────────────────────────────────────────
  echo -e "  ${CYAN}▸ [2/3] 프론트엔드 의존성 동기화...${NC}"
  cd "$HAN_DIR/frontend"
  local npm_result
  if npm_result=$(npm install 2>&1); then
    local added updated
    added=$(echo "$npm_result"  | grep -o 'added [0-9]*'   | grep -o '[0-9]*' | tail -1 || echo "0")
    updated=$(echo "$npm_result" | grep -o 'changed [0-9]*' | grep -o '[0-9]*' | tail -1 || echo "0")
    echo -e "  ${GREEN}  ✓ npm install 완료${NC} (추가: ${added:-0}개, 변경: ${updated:-0}개)"
  else
    echo -e "  ${RED}  ✗ npm install 실패${NC}"
    echo "       cd $HAN_DIR/frontend && npm install"
  fi

  # ─ [3/4] han CLI 자신도 업데이트 ─────────────────────────────────────────
  echo -e "  ${CYAN}▸ [3/4] han CLI 업데이트...${NC}"
  local CLI_PATH
  CLI_PATH=$(command -v han 2>/dev/null || echo "")
  if [ -n "$CLI_PATH" ] && [ "$CLI_PATH" != "$HAN_DIR/han" ]; then
    cp "$HAN_DIR/han" "$CLI_PATH"
    chmod +x "$CLI_PATH"
    echo -e "  ${GREEN}  ✓ han CLI 업데이트됨${NC} ($CLI_PATH)"
  else
    echo -e "  ${DIM}  - CLI 업데이트 불필요${NC}"
  fi

  # ─ [4/4] DB 스키마 자동 마이그레이션 ─────────────────────────────────────
  echo -e "  ${CYAN}▸ [4/4] DB 스키마 마이그레이션...${NC}"
  local VENV_PYTHON="$HAN_DIR/backend/venv/bin/python"
  local DB_PATH_MIG="$HAN_DIR/backend/han_group.db"
  if [ -f "$VENV_PYTHON" ] && [ -f "$DB_PATH_MIG" ]; then
    # 마이그레이션 (백업은 이미 앞에서 했으므로 생략)
    local MIG_OUT MIG_EXIT=0
    set +e
    MIG_OUT=$(HAN_DIR="$HAN_DIR" "$VENV_PYTHON" - <<'PYEOF' 2>&1
import sys, os
sys.path.insert(0, os.path.join(os.environ["HAN_DIR"], "backend"))
from sqlalchemy import create_engine, inspect, text
from core.database import Base
import models.models  # noqa
DB_URL = "sqlite:///" + os.path.join(os.environ["HAN_DIR"], "backend", "han_group.db")
engine = create_engine(DB_URL)
inspector = inspect(engine)
existing_before = set(inspector.get_table_names())
Base.metadata.create_all(engine, checkfirst=True)
inspector = inspect(engine)
new_tables = set(inspector.get_table_names()) - existing_before
TYPE_MAP = {"VARCHAR":"TEXT","STRING":"TEXT","TEXT":"TEXT","INTEGER":"INTEGER",
            "BIGINT":"INTEGER","INT":"INTEGER","FLOAT":"REAL","NUMERIC":"REAL",
            "BOOLEAN":"INTEGER","DATETIME":"DATETIME","JSON":"TEXT","LARGEBINARY":"BLOB","BLOB":"BLOB"}
def to_sqlite(t): return next((v for k,v in TYPE_MAP.items() if k in t.upper()), "TEXT")
def dflt_clause(col):
    if col.default and col.default.is_scalar:
        dv = col.default.arg
        if dv is None: return " DEFAULT NULL"
        if isinstance(dv, bool): return f" DEFAULT {int(dv)}"
        if isinstance(dv, str): return f" DEFAULT '{dv.replace(chr(39), chr(39)*2)}'"
        return f" DEFAULT {dv}"
    return " DEFAULT NULL"
added = 0
for tname, tobj in Base.metadata.tables.items():
    if tname not in inspector.get_table_names(): continue
    existing_cols = {c["name"] for c in inspector.get_columns(tname)}
    for col in tobj.columns:
        if col.name in existing_cols: continue
        sql = f"ALTER TABLE {tname} ADD COLUMN {col.name} {to_sqlite(str(col.type))}{dflt_clause(col)}"
        with engine.connect() as conn:
            conn.execute(text(sql)); conn.commit()
        added += 1
print(f"신규 테이블: {len(new_tables)}개, 추가 컬럼: {added}개")
PYEOF
    )
    MIG_EXIT=$?
    set -e
    if [ $MIG_EXIT -eq 0 ]; then
      echo -e "  ${GREEN}  ✓ DB 마이그레이션 완료${NC}  (${MIG_OUT})"
    else
      echo -e "  ${YELLOW}  △ DB 마이그레이션 실패 — 수동 실행: han migrate${NC}"
    fi
  elif [ ! -f "$DB_PATH_MIG" ]; then
    echo -e "  ${DIM}  - DB 없음 (첫 시작 시 자동 생성)${NC}"
  else
    echo -e "  ${DIM}  - venv 없음 — han init_check --fix 로 설치 후 한 번 더 실행하세요${NC}"
  fi

  echo ""
  echo -e "${GREEN}  ✅ 업데이트 완료!${NC}"
  local new_commit
  new_commit=$(git -C "$HAN_DIR" rev-parse --short HEAD 2>/dev/null || echo "알 수 없음")
  echo -e "  ${DIM}커밋: $new_commit${NC}"
  echo ""

  if [ -t 0 ]; then
    read -r -p "  지금 바로 서버를 시작하시겠습니까? (Y/n) > " START_NOW
    START_NOW="${START_NOW:-Y}"
    if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
      cmd_start "--daemon"
    fi
  fi
}

# ── han reset ─────────────────────────────────────────────────────────────────
cmd_reset() {
  echo -e "${YELLOW}⚠ 경고: 모든 데이터(DB)가 삭제됩니다.${NC}"
  read -r -p "  계속하시겠습니까? (y/N) > " CONFIRM
  if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "  취소됩니다."
    exit 0
  fi

  cmd_stop 2>/dev/null || true

  local DB_PATH="$HAN_DIR/backend/han_group.db"
  if [ -f "$DB_PATH" ]; then
    # 리셋 전 자동 백업
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    cp "$DB_PATH" "$HAN_BACKUP_DIR/han_group_before_reset_${ts}.db"
    echo -e "  ${GREEN}✓ DB 백업됨${NC} (before_reset_${ts}.db)"
    rm "$DB_PATH"
    echo -e "  ${GREEN}✓ 데이터베이스 삭제됨${NC}"
  else
    echo -e "  ${YELLOW}⚠ DB 파일이 없습니다 (이미 초기화 상태)${NC}"
  fi

  echo ""
  read -r -p "  지금 바로 시작하시겠습니까? (Y/n) > " START_NOW
  START_NOW="${START_NOW:-Y}"
  if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
    cmd_start "--daemon"
  fi
}

# ── han backup ────────────────────────────────────────────────────────────────
cmd_backup() {
  # --auto 서브커맨드 분기
  case "${1:-}" in
    --auto) shift; cmd_backup_auto "$@"; return ;;
  esac

  local DB_PATH="$HAN_DIR/backend/han_group.db"

  if [ ! -f "$DB_PATH" ]; then
    echo -e "${YELLOW}⚠ DB 파일이 없습니다. 서버를 한 번 실행하면 생성됩니다.${NC}"
    exit 1
  fi

  local ts
  ts=$(date +%Y%m%d_%H%M%S)
  local BACKUP_FILE="$HAN_BACKUP_DIR/han_group_${ts}.db"

  cp "$DB_PATH" "$BACKUP_FILE"

  echo ""
  echo -e "  ${GREEN}✓ 백업 완료${NC}"
  echo "  파일: $BACKUP_FILE"
  echo "  크기: $(du -sh "$BACKUP_FILE" | cut -f1)"
  echo ""

  # 보관 목록 표시
  local COUNT
  COUNT=$(ls "$HAN_BACKUP_DIR"/*.db 2>/dev/null | wc -l | tr -d ' ')
  echo -e "  ${DIM}총 보관된 백업: ${COUNT}개${NC}"
  echo -e "  ${DIM}백업 위치: $HAN_BACKUP_DIR${NC}"
  echo ""
}

# ── han backup --auto ──────────────────────────────────────────────────────────
# 사용법:
#   han backup --auto enable [--interval hourly|6h|daily|weekly]
#   han backup --auto disable
#   han backup --auto status
# ─────────────────────────────────────────────────────────────────────────────
cmd_backup_auto() {
  local SUBCMD="${1:-status}"
  shift || true

  # crontab 사용 가능 여부 확인
  if ! command -v crontab &>/dev/null; then
    echo -e "${RED}✗ crontab 명령을 찾을 수 없습니다.${NC}"
    echo ""
    case $OS in
      wsl|linux) echo "  설치: sudo apt install -y cron && sudo service cron start" ;;
      macos)     echo "  macOS는 기본 내장되어 있습니다. launchctl로 cron 활성화 필요:" ;;
      *)         echo "  cron 데몬을 설치하세요." ;;
    esac
    exit 1
  fi

  # han CLI 경로 (cron에서 사용할 절대 경로)
  local HAN_BIN
  HAN_BIN=$(command -v han 2>/dev/null || echo "$HAN_DIR/han")

  # crontab 항목 식별 태그
  local CRON_TAG="# HAN Group OS auto-backup"

  case "$SUBCMD" in
    # ── enable ────────────────────────────────────────────────────────────────
    enable)
      local INTERVAL="daily"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --interval) INTERVAL="${2:-daily}"; shift 2 ;;
          *) shift ;;
        esac
      done

      # 인터벌 → cron 표현식 변환
      local CRON_EXPR
      case "$INTERVAL" in
        hourly|1h)  CRON_EXPR="0 * * * *"    ;;
        6h)         CRON_EXPR="0 */6 * * *"   ;;
        daily|24h)  CRON_EXPR="0 2 * * *"     ;;
        weekly)     CRON_EXPR="0 2 * * 0"     ;;
        *)
          echo -e "${RED}✗ 지원하지 않는 인터벌: $INTERVAL${NC}"
          echo "  지원: hourly, 6h, daily, weekly"
          exit 1
          ;;
      esac

      local CRON_LINE="$CRON_EXPR $HAN_BIN backup $CRON_TAG"

      # 기존 항목 제거 후 새 항목 추가
      local EXISTING
      EXISTING=$(crontab -l 2>/dev/null || true)
      local CLEANED
      CLEANED=$(echo "$EXISTING" | grep -v "$CRON_TAG" || true)

      (
        echo "$CLEANED"
        echo "$CRON_LINE"
      ) | grep -v '^$' | crontab -

      echo ""
      echo -e "  ${GREEN}✓ 자동 백업 등록 완료${NC}"
      echo "  인터벌 : $INTERVAL  ($CRON_EXPR)"
      echo "  명령   : $HAN_BIN backup"
      echo "  저장   : $HAN_BACKUP_DIR"
      echo ""
      echo "  확인: han backup --auto status"
      echo "  해제: han backup --auto disable"
      echo ""
      ;;

    # ── disable ───────────────────────────────────────────────────────────────
    disable)
      local EXISTING
      EXISTING=$(crontab -l 2>/dev/null || true)
      if echo "$EXISTING" | grep -q "$CRON_TAG"; then
        echo "$EXISTING" | grep -v "$CRON_TAG" | crontab -
        echo -e "  ${GREEN}✓ 자동 백업 cron 항목 제거됨${NC}"
      else
        echo -e "  ${YELLOW}⚠ 등록된 자동 백업 항목이 없습니다.${NC}"
      fi
      echo ""
      ;;

    # ── status ────────────────────────────────────────────────────────────────
    status)
      echo ""
      echo -e "${BOLD}han backup --auto 상태${NC}"
      echo ""
      local EXISTING
      EXISTING=$(crontab -l 2>/dev/null || true)
      local ENTRY
      ENTRY=$(echo "$EXISTING" | grep "$CRON_TAG" || true)

      if [ -n "$ENTRY" ]; then
        echo -e "  ${GREEN}● 자동 백업 활성화됨${NC}"
        echo ""
        echo "  cron 항목:"
        echo "    $ENTRY"
        echo ""

        # 다음 실행 시간 추정 (간단 안내)
        local EXPR; EXPR=$(echo "$ENTRY" | awk '{print $1" "$2" "$3" "$4" "$5}')
        echo "  cron 표현식: $EXPR"
        case "$EXPR" in
          "0 * * * *")    echo "  주기: 매 시간 정각" ;;
          "0 */6 * * *")  echo "  주기: 6시간마다 (0, 6, 12, 18시)" ;;
          "0 2 * * *")    echo "  주기: 매일 오전 2시" ;;
          "0 2 * * 0")    echo "  주기: 매주 일요일 오전 2시" ;;
          *)              echo "  주기: 사용자 정의" ;;
        esac
      else
        echo -e "  ${DIM}○ 자동 백업 비활성화 상태${NC}"
        echo ""
        echo "  활성화 방법:"
        echo "    han backup --auto enable                    # 매일 오전 2시 (기본)"
        echo "    han backup --auto enable --interval hourly  # 매시간"
        echo "    han backup --auto enable --interval 6h      # 6시간마다"
        echo "    han backup --auto enable --interval weekly  # 매주"
      fi

      # 백업 현황
      echo ""
      local COUNT
      COUNT=$(ls "$HAN_BACKUP_DIR"/*.db 2>/dev/null | wc -l | tr -d ' ')
      local LATEST=""
      if [ "$COUNT" -gt 0 ]; then
        LATEST=$(ls -t "$HAN_BACKUP_DIR"/*.db 2>/dev/null | head -1)
        LATEST=" (최신: $(basename "$LATEST"))"
      fi
      echo "  저장된 백업: ${COUNT}개${LATEST}"
      echo "  백업 경로  : $HAN_BACKUP_DIR"
      echo ""
      ;;

    *)
      echo "사용법: han backup --auto [enable|disable|status]"
      echo ""
      echo "  enable   [--interval hourly|6h|daily|weekly]   자동 백업 cron 등록"
      echo "  disable                                         자동 백업 cron 해제"
      echo "  status                                          현재 상태 확인"
      exit 1
      ;;
  esac
}

# ── han restore ───────────────────────────────────────────────────────────────
cmd_restore() {
  echo ""

  # 백업 목록 로드
  local BACKUPS=()
  while IFS= read -r -d '' f; do
    BACKUPS+=("$f")
  done < <(find "$HAN_BACKUP_DIR" -name "*.db" -print0 2>/dev/null | sort -rz)

  if [ ${#BACKUPS[@]} -eq 0 ]; then
    echo -e "${YELLOW}⚠ 저장된 백업이 없습니다.${NC}"
    echo "  'han backup' 으로 먼저 백업을 생성하세요."
    exit 1
  fi

  echo -e "${BOLD}저장된 백업 목록${NC}"
  echo ""

  local i=1
  for f in "${BACKUPS[@]}"; do
    local fname size mtime
    fname=$(basename "$f")
    size=$(du -sh "$f" 2>/dev/null | cut -f1)
    mtime=$(date -r "$f" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || stat -c "%y" "$f" 2>/dev/null | cut -d. -f1)
    echo "  $i) $fname  [$size]  $mtime"
    ((i++))
  done

  echo ""
  read -r -p "  복원할 번호를 선택하세요 (1-${#BACKUPS[@]}, 취소: q) > " CHOICE

  if [[ "$CHOICE" == "q" || -z "$CHOICE" ]]; then
    echo "  취소됩니다."
    exit 0
  fi

  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt ${#BACKUPS[@]} ]; then
    echo -e "${RED}✗ 잘못된 번호입니다.${NC}"
    exit 1
  fi

  local SELECTED="${BACKUPS[$((CHOICE-1))]}"
  echo ""
  echo -e "${YELLOW}⚠ 현재 DB를 '$(basename "$SELECTED")'으로 교체합니다.${NC}"
  read -r -p "  계속하시겠습니까? (y/N) > " CONFIRM
  if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "  취소됩니다."
    exit 0
  fi

  cmd_stop 2>/dev/null || true

  local DB_PATH="$HAN_DIR/backend/han_group.db"

  # 현재 DB 임시 백업
  if [ -f "$DB_PATH" ]; then
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    cp "$DB_PATH" "$HAN_BACKUP_DIR/han_group_before_restore_${ts}.db"
    echo -e "  ${GREEN}✓ 현재 DB 임시 백업됨 (before_restore_${ts}.db)${NC}"
  fi

  cp "$SELECTED" "$DB_PATH"
  echo -e "  ${GREEN}✓ 복원 완료: $(basename "$SELECTED")${NC}"
  echo ""

  read -r -p "  지금 바로 서버를 시작하시겠습니까? (Y/n) > " START_NOW
  START_NOW="${START_NOW:-Y}"
  if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
    cmd_start "--daemon"
  fi
}

# ── han config ────────────────────────────────────────────────────────────────
cmd_config() {
  local ENV_FILE="$HAN_DIR/backend/.env"
  local SUBCMD="${1:-list}"
  shift || true

  case "$SUBCMD" in
    set)
      local KEY="${1:-}"; local VALUE="${2:-}"
      if [ -z "$KEY" ]; then echo "사용법: han config set <KEY> <VALUE>"; exit 1; fi
      if [ ! -f "$ENV_FILE" ]; then echo -e "${RED}✗ .env 없음 — han init_check --fix 먼저 실행${NC}"; exit 1; fi
      if grep -q "^${KEY}=" "$ENV_FILE" 2>/dev/null; then
        if sed --version 2>/dev/null | grep -q GNU; then
          sed -i "s|^${KEY}=.*|${KEY}=${VALUE}|" "$ENV_FILE"
        else
          sed -i '' "s|^${KEY}=.*|${KEY}=${VALUE}|" "$ENV_FILE"
        fi
        echo -e "  ${GREEN}✓ ${KEY} 업데이트됨${NC}"
      else
        echo "${KEY}=${VALUE}" >> "$ENV_FILE"
        echo -e "  ${GREEN}✓ ${KEY} 추가됨${NC}"
      fi
      if [[ "$KEY" == *"API_KEY"* ]] && [ -n "$VALUE" ]; then
        echo -e "  ${DIM}값: ${VALUE:0:8}...${VALUE: -4}${NC}"
      else
        echo -e "  ${DIM}값: ${VALUE}${NC}"
      fi
      echo ""
      echo "  변경 적용: han restart"
      ;;

    get)
      local KEY="${1:-}"
      [ -z "$KEY" ] && { echo "사용법: han config get <KEY>"; exit 1; }
      if [ ! -f "$ENV_FILE" ]; then echo -e "${RED}✗ .env 없음${NC}"; exit 1; fi
      local LINE
      LINE=$(grep "^${KEY}=" "$ENV_FILE" 2>/dev/null || true)
      if [ -n "$LINE" ]; then
        local VAL="${LINE#*=}"
        if [[ "$KEY" == *"API_KEY"* ]] && [ -n "$VAL" ]; then
          echo "${KEY}=${VAL:0:8}...${VAL: -4}"
        else
          echo "$LINE"
        fi
      else
        echo -e "${YELLOW}⚠ ${KEY} 키 없음${NC}"
      fi
      ;;

    list|"")
      if [ -f "$ENV_FILE" ]; then
        echo ""
        echo -e "${BOLD}현재 설정 ($ENV_FILE)${NC}"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        while IFS= read -r line; do
          if [[ "$line" =~ _API_KEY= ]] && [[ ! "$line" =~ =$ ]]; then
            local key="${line%%=*}"
            local val="${line##*=}"
            local masked="${val:0:8}****${val: -4}"
            echo "  $key=$masked"
          else
            echo "  $line"
          fi
        done < "$ENV_FILE"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "  han config set <KEY> <VALUE>  — 값 직접 수정"
        echo "  수정 후 'han restart' 로 재시작하세요."
        echo ""
      else
        echo -e "${YELLOW}⚠ .env 없음. 'han start' 로 먼저 실행하세요.${NC}"
      fi
      ;;

    *)
      echo "사용법: han config [set|get|list]"
      exit 1
      ;;
  esac
}

# ── han path-fix ──────────────────────────────────────────────────────────────
# 사용법:
#   eval $(han path-fix)          현재 터미널 즉시 적용
#   han path-fix --apply          ~/.bashrc / ~/.zshrc 에 영구 등록
#   han path-fix --status         현재 PATH 상태 확인
# ─────────────────────────────────────────────────────────────────────────────
cmd_path_fix() {
  local MODE="eval"   # eval | apply | status
  case "${1:-}" in
    --apply)  MODE="apply"  ;;
    --status) MODE="status" ;;
    "")       MODE="eval"   ;;
  esac

  local BIN_DIR="$HOME/.local/bin"
  local IN_PATH=false
  [[ ":$PATH:" == *":$BIN_DIR:"* ]] && IN_PATH=true

  # rc 파일 판별
  local RC
  if [[ "$SHELL" == *"zsh"* ]]; then RC="$HOME/.zshrc"
  else RC="$HOME/.bashrc"; fi

  case "$MODE" in
    # ── eval 모드: export 명령을 stdout으로 출력 (eval 용) ───────────────────
    eval)
      if $IN_PATH; then
        # eval 시 아무것도 안 해도 되지만 메시지는 stderr로
        echo -e "  ${GREEN}✓ PATH 이미 설정됨${NC}" >&2
      else
        # ← 이 한 줄만 stdout (eval에서 실행됨)
        echo "export PATH=\"$BIN_DIR:\$PATH\""
        echo -e "  ${GREEN}✓ PATH 적용됨 ($BIN_DIR)${NC}" >&2
        echo -e "  ${DIM}영구 등록하려면: han path-fix --apply${NC}" >&2
      fi
      ;;

    # ── apply 모드: rc 파일에 영구 등록 ──────────────────────────────────────
    apply)
      echo ""
      local ALREADY_IN_RC=false
      grep -qF 'HOME/.local/bin' "$RC" 2>/dev/null && ALREADY_IN_RC=true

      if $ALREADY_IN_RC; then
        echo -e "  ${GREEN}✓ 이미 $RC 에 PATH가 등록되어 있습니다.${NC}"
      else
        echo "" >> "$RC"
        echo "# HAN Group OS CLI" >> "$RC"
        echo "export PATH=\"\$HOME/.local/bin:\$PATH\"" >> "$RC"
        echo -e "  ${GREEN}✓ PATH 영구 등록됨${NC} → $RC"
      fi

      if ! $IN_PATH; then
        export PATH="$BIN_DIR:$PATH"
        echo -e "  ${GREEN}✓ 현재 세션에도 즉시 적용됨${NC}"
      fi

      echo ""
      echo -e "  ${DIM}새 터미널에서도 자동 적용됩니다.${NC}"
      echo -e "  ${DIM}현재 터미널 즉시 적용: source $RC${NC}"
      echo ""
      ;;

    # ── status 모드: 현재 PATH 상태 진단 ─────────────────────────────────────
    status)
      echo ""
      echo -e "${BOLD}han path-fix 상태${NC}"
      echo ""
      if $IN_PATH; then
        echo -e "  ${GREEN}✓ $BIN_DIR 이 PATH에 포함됨${NC}"
      else
        echo -e "  ${RED}✗ $BIN_DIR 이 PATH에 없음${NC}"
        echo ""
        echo "  해결 방법:"
        echo "    eval \$(han path-fix)       # 현재 터미널만 즉시 적용"
        echo "    han path-fix --apply       # ~/.bashrc 에 영구 등록"
      fi

      echo ""
      local HAN_BIN
      HAN_BIN=$(command -v han 2>/dev/null || echo "")
      if [ -n "$HAN_BIN" ]; then
        echo -e "  ${GREEN}✓ han 명령 위치: $HAN_BIN${NC}"
      else
        echo -e "  ${RED}✗ han 명령을 찾을 수 없음${NC}"
      fi

      local IN_RC=false
      grep -qF 'HOME/.local/bin' "$RC" 2>/dev/null && IN_RC=true
      if $IN_RC; then
        echo -e "  ${GREEN}✓ $RC 에 PATH 등록됨 (새 터미널 자동 적용)${NC}"
      else
        echo -e "  ${YELLOW}△ $RC 에 PATH 미등록${NC}"
        echo "    han path-fix --apply 로 등록하세요"
      fi
      echo ""
      ;;
  esac
}

# ── han self-update ────────────────────────────────────────────────────────────
# han CLI 바이너리만 GitHub에서 직접 교체 (git pull 없이)
# ─────────────────────────────────────────────────────────────────────────────
cmd_self_update() {
  local RAW_URL="https://raw.githubusercontent.com/rrrr66254/HanGroupOS/master/han"

  echo ""
  echo -e "${BOLD}han self-update — CLI 바이너리 단독 업데이트${NC}"
  echo ""

  # 현재 CLI 경로 확인
  local CLI_PATH
  CLI_PATH=$(command -v han 2>/dev/null || echo "$HOME/.local/bin/han")
  echo -e "  경로    : $CLI_PATH"
  echo -e "  현재 버전: v${HAN_VERSION}"
  echo ""

  # 임시 파일로 다운로드
  echo -e "  ${CYAN}▸ GitHub 최신 버전 다운로드 중...${NC}"
  local TMP_FILE
  TMP_FILE=$(mktemp /tmp/han_self_update_XXXXXX)

  if ! curl -fsSL "$RAW_URL" -o "$TMP_FILE" 2>/dev/null; then
    rm -f "$TMP_FILE"
    echo -e "  ${RED}✗ 다운로드 실패 — 네트워크 또는 저장소 주소를 확인하세요.${NC}"
    echo "    URL: $RAW_URL"
    exit 1
  fi

  # 새 버전 번호 추출
  local NEW_VER
  NEW_VER=$(grep '^HAN_VERSION=' "$TMP_FILE" 2>/dev/null | cut -d'"' -f2 || echo "알 수 없음")

  if [ "$NEW_VER" = "$HAN_VERSION" ]; then
    echo -e "  ${GREEN}✓ 이미 최신 버전입니다 (v${HAN_VERSION}).${NC}"
    rm -f "$TMP_FILE"
    echo ""
    return 0
  fi

  # 교체
  chmod +x "$TMP_FILE"
  cp "$TMP_FILE" "$CLI_PATH"
  chmod +x "$CLI_PATH"
  rm -f "$TMP_FILE"

  echo -e "  ${GREEN}✓ 업데이트 완료${NC}  v${HAN_VERSION} → v${NEW_VER}"
  echo "  경로: $CLI_PATH"

  # HAN_DIR/han 도 동기화
  if [ -f "$HAN_DIR/han" ] && [ "$CLI_PATH" != "$HAN_DIR/han" ]; then
    cp "$CLI_PATH" "$HAN_DIR/han"
    chmod +x "$HAN_DIR/han"
    echo -e "  ${GREEN}✓ $HAN_DIR/han 동기화됨${NC}"
  fi

  echo ""
  echo -e "  ${DIM}전체 업데이트(pip/npm 포함): han update${NC}"
  echo ""
}

# ── han diff-env ──────────────────────────────────────────────────────────────
# 현재 .env 와 기본 템플릿을 비교해 설정됨/기본값/누락/커스텀 키를 표시
# ─────────────────────────────────────────────────────────────────────────────
cmd_diff_env() {
  local FIX_MODE=false
  [[ "${1:-}" == "--fix" ]] && FIX_MODE=true

  local ENV_FILE="$HAN_DIR/backend/.env"

  # 템플릿 키 목록 (순서 유지)
  local TEMPLATE_KEYS=("SECRET_KEY" "DATABASE_URL" "DEFAULT_PROVIDER"
    "ANTHROPIC_API_KEY" "OPENAI_API_KEY" "GEMINI_API_KEY"
    "OLLAMA_BASE_URL" "OLLAMA_MODEL")

  # 템플릿 기본값 (키=값 형태로 일치 여부 판단)
  declare -A TDEFAULTS
  TDEFAULTS["SECRET_KEY"]="han-group-os-secret-key-change-in-production"
  TDEFAULTS["DATABASE_URL"]="sqlite:///./han_group.db"
  TDEFAULTS["DEFAULT_PROVIDER"]="mock"
  TDEFAULTS["ANTHROPIC_API_KEY"]=""
  TDEFAULTS["OPENAI_API_KEY"]=""
  TDEFAULTS["GEMINI_API_KEY"]=""
  TDEFAULTS["OLLAMA_BASE_URL"]="http://localhost:11434"
  TDEFAULTS["OLLAMA_MODEL"]="qwen2.5"

  echo ""
  echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${BOLD}║     han diff-env — .env 템플릿 비교          ║${NC}"
  echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
  echo ""

  if [ ! -f "$ENV_FILE" ]; then
    echo -e "  ${RED}✗ .env 파일 없음: $ENV_FILE${NC}"
    echo "  han init_check --fix 로 먼저 생성하세요."
    echo ""
    exit 1
  fi

  echo -e "  ${DIM}파일: $ENV_FILE${NC}"
  echo ""

  local cnt_ok=0 cnt_default=0 cnt_missing=0 cnt_custom=0

  # ─ 1. 템플릿 키 순서대로 비교 ───────────────────────────────────────────────
  echo -e "${BOLD}[ 템플릿 키 비교 ]${NC}"
  echo ""
  for KEY in "${TEMPLATE_KEYS[@]}"; do
    local DFLT="${TDEFAULTS[$KEY]}"
    local LINE
    LINE=$(grep "^${KEY}=" "$ENV_FILE" 2>/dev/null || true)

    if [ -z "$LINE" ]; then
      # 키 자체가 없음
      echo -e "  ${RED}✗ [누락]   ${NC} ${KEY}"
      echo -e "             기본값: ${DIM}${DFLT:-<빈 값>}${NC}"
      cnt_missing=$((cnt_missing+1))
    else
      local VAL="${LINE#*=}"
      # API 키 / SECRET 마스킹
      local DISPLAY="$VAL"
      if [[ "$KEY" == *"API_KEY"* || "$KEY" == *"SECRET"* ]] && [ ${#VAL} -gt 10 ]; then
        DISPLAY="${VAL:0:6}****${VAL: -4}"
      fi

      if [ "$VAL" = "$DFLT" ]; then
        if [ -z "$VAL" ]; then
          echo -e "  ${YELLOW}△ [미설정] ${NC} ${KEY}=${DIM}<빈 값>${NC}"
        else
          echo -e "  ${DIM}○ [기본값] ${NC} ${KEY}=${DIM}${DISPLAY}${NC}"
        fi
        cnt_default=$((cnt_default+1))
      else
        echo -e "  ${GREEN}✓ [설정됨] ${NC} ${KEY}=${DISPLAY}"
        cnt_ok=$((cnt_ok+1))
      fi
    fi
  done

  # ─ 2. 커스텀 키 (.env에만 있는 키) ─────────────────────────────────────────
  echo ""
  echo -e "${BOLD}[ 커스텀 키 (템플릿에 없는 항목) ]${NC}"
  echo ""
  local has_custom=false
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == "#"* ]] && continue
    local K="${line%%=*}"
    local found=false
    for TK in "${TEMPLATE_KEYS[@]}"; do
      [ "$TK" = "$K" ] && { found=true; break; }
    done
    if ! $found; then
      local V="${line#*=}"
      local DV="$V"
      if [[ "$K" == *"API_KEY"* || "$K" == *"SECRET"* ]] && [ ${#V} -gt 10 ]; then
        DV="${V:0:6}****${V: -4}"
      fi
      echo -e "  ${CYAN}+ [커스텀]  ${NC} ${K}=${DV}"
      cnt_custom=$((cnt_custom+1))
      has_custom=true
    fi
  done < "$ENV_FILE"
  $has_custom || echo -e "  ${DIM}(없음)${NC}"

  # ─ 요약 ────────────────────────────────────────────────────────────────────
  echo ""
  echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo -e "  결과 요약"
  echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  [ $cnt_ok      -gt 0 ] && echo -e "  ${GREEN}✓ 설정됨  ${NC}: ${cnt_ok}개"
  [ $cnt_default -gt 0 ] && echo -e "  ${YELLOW}△ 기본/미설정${NC}: ${cnt_default}개  (변경 권장)"
  [ $cnt_missing -gt 0 ] && echo -e "  ${RED}✗ 누락    ${NC}: ${cnt_missing}개  → han init_check --fix"
  [ $cnt_custom  -gt 0 ] && echo -e "  ${CYAN}+ 커스텀  ${NC}: ${cnt_custom}개"
  echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  if ! $FIX_MODE; then
    if [ $cnt_missing -gt 0 ]; then
      echo ""
      echo -e "  ${YELLOW}▶ 누락 키 추가:${NC}  han init_check --fix"
    fi
    if [ $cnt_default -gt 0 ]; then
      echo ""
      echo -e "  ${DIM}▶ 대화형 설정:${NC}  han diff-env --fix"
    fi
    echo ""
    return 0
  fi

  # ── --fix 모드: 누락/미설정 키를 대화형으로 입력 ──────────────────────────
  local fix_count=0
  if [ $((cnt_missing + cnt_default)) -eq 0 ]; then
    echo ""
    echo -e "  ${GREEN}✓ 모든 키가 이미 설정되어 있습니다.${NC}"
    echo ""
    return 0
  fi

  echo ""
  echo -e "${BOLD}[ --fix 모드: 누락/미설정 키 입력 ]${NC}"
  echo -e "  ${DIM}(Enter 건너뛰기, Ctrl+C 중단)${NC}"
  echo ""

  for KEY in "${TEMPLATE_KEYS[@]}"; do
    local DFLT="${TDEFAULTS[$KEY]}"
    local LINE
    LINE=$(grep "^${KEY}=" "$ENV_FILE" 2>/dev/null || true)
    local VAL="${LINE#*=}"

    # 이미 사용자 설정된 키는 건너뜀
    if [ -n "$LINE" ] && [ "$VAL" != "$DFLT" ] && [ -n "$VAL" ]; then
      continue
    fi

    # 누락이거나 기본값/빈 값인 경우
    local PROMPT_LABEL
    if [ -z "$LINE" ]; then
      PROMPT_LABEL="${RED}[누락]${NC}  "
    elif [ -z "$VAL" ]; then
      PROMPT_LABEL="${YELLOW}[미설정]${NC}"
    else
      PROMPT_LABEL="${DIM}[기본값]${NC}"
    fi

    # API 키 / SECRET 은 -s(숨김) 입력
    local READ_OPTS=()
    if [[ "$KEY" == *"API_KEY"* || "$KEY" == *"SECRET"* ]]; then
      READ_OPTS=(-s)
    fi

    echo -e "  ${PROMPT_LABEL} ${KEY}"
    [ -n "$DFLT" ] && echo -e "               현재/기본값: ${DIM}${DFLT}${NC}"

    local NEW_VAL=""
    read -r "${READ_OPTS[@]}" -p "               새 값 입력 (Enter=건너뛰기): " NEW_VAL
    # -s 옵션 후 줄바꿈 출력
    [[ "${READ_OPTS[*]}" == *"-s"* ]] && echo ""

    if [ -z "$NEW_VAL" ]; then
      echo -e "               ${DIM}→ 건너뜀${NC}"
      echo ""
      continue
    fi

    # .env 업데이트
    if grep -q "^${KEY}=" "$ENV_FILE" 2>/dev/null; then
      if sed --version 2>/dev/null | grep -q GNU; then
        sed -i "s|^${KEY}=.*|${KEY}=${NEW_VAL}|" "$ENV_FILE"
      else
        sed -i '' "s|^${KEY}=.*|${KEY}=${NEW_VAL}|" "$ENV_FILE"
      fi
    else
      echo "${KEY}=${NEW_VAL}" >> "$ENV_FILE"
    fi
    echo -e "               ${GREEN}✓ 저장됨${NC}"
    echo ""
    fix_count=$((fix_count+1))
  done

  echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  if [ $fix_count -gt 0 ]; then
    echo -e "  ${GREEN}✓ ${fix_count}개 키 업데이트됨${NC}  — 변경 적용: han restart"
  else
    echo -e "  ${DIM}변경사항 없음${NC}"
  fi
  echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
}

# ── han migrate ───────────────────────────────────────────────────────────────
# SQLite 스키마 자동 마이그레이션
#   - 새 테이블: Base.metadata.create_all(checkfirst=True)
#   - 누락 컬럼: ALTER TABLE ... ADD COLUMN
#   - 기존 데이터 보존, 실행 전 자동 백업
# ─────────────────────────────────────────────────────────────────────────────
cmd_migrate() {
  local DB_PATH="$HAN_DIR/backend/han_group.db"
  local VENV_PYTHON="$HAN_DIR/backend/venv/bin/python"

  echo ""
  echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${BOLD}║   han migrate — DB 스키마 자동 마이그레이션   ║${NC}"
  echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
  echo ""

  if [ ! -f "$VENV_PYTHON" ]; then
    echo -e "  ${RED}✗ Python venv 없음 — han init_check --fix 먼저 실행하세요.${NC}"
    echo ""
    exit 1
  fi

  if [ ! -f "$DB_PATH" ]; then
    echo -e "  ${YELLOW}⚠ DB 파일이 없습니다.${NC}"
    echo "    han start --daemon 으로 서버를 한 번 시작하면 자동 생성됩니다."
    echo ""
    exit 1
  fi

  # DB 자동 백업 (마이그레이션 전)
  local ts
  ts=$(date +%Y%m%d_%H%M%S)
  local BACKUP_FILE="$HAN_BACKUP_DIR/han_group_before_migrate_${ts}.db"
  cp "$DB_PATH" "$BACKUP_FILE"
  echo -e "  ${GREEN}✓ DB 백업됨${NC} → $(basename "$BACKUP_FILE")"
  echo ""

  echo -e "  ${CYAN}▸ 스키마 비교 및 마이그레이션 실행 중...${NC}"
  echo ""

  local MIGRATE_EXIT=0
  set +e
  HAN_DIR="$HAN_DIR" "$VENV_PYTHON" - <<'PYEOF'
import sys, os
sys.path.insert(0, os.path.join(os.environ["HAN_DIR"], "backend"))

from sqlalchemy import create_engine, inspect, text
from core.database import Base
import models.models  # noqa: F401 — 모든 모델 임포트해 metadata 등록

DB_URL = "sqlite:///" + os.path.join(os.environ["HAN_DIR"], "backend", "han_group.db")
engine = create_engine(DB_URL)

# ─ 1. 새 테이블 생성 ─────────────────────────────────────────────────────────
print("  [ 1/2 ] 새 테이블 확인...")
inspector = inspect(engine)
existing_tables_before = set(inspector.get_table_names())

Base.metadata.create_all(engine, checkfirst=True)

inspector = inspect(engine)
existing_tables_after = set(inspector.get_table_names())
new_tables = existing_tables_after - existing_tables_before

if new_tables:
    for t in sorted(new_tables):
        print(f"    \033[32m+ 테이블 생성됨: {t}\033[0m")
else:
    print("    \033[2m신규 테이블 없음\033[0m")

# ─ 2. 누락 컬럼 추가 (ALTER TABLE ADD COLUMN) ────────────────────────────────
print("")
print("  [ 2/2 ] 누락 컬럼 확인...")

# SQLAlchemy 타입 문자열 → SQLite 타입
TYPE_MAP = {
    "VARCHAR": "TEXT", "STRING": "TEXT", "TEXT": "TEXT",
    "INTEGER": "INTEGER", "BIGINT": "INTEGER", "INT": "INTEGER",
    "FLOAT": "REAL", "NUMERIC": "REAL", "BOOLEAN": "INTEGER",
    "DATETIME": "DATETIME", "JSON": "TEXT",
    "LARGEBINARY": "BLOB", "BLOB": "BLOB",
}

def to_sqlite_type(col_type_str):
    upper = col_type_str.upper()
    for k, v in TYPE_MAP.items():
        if k in upper:
            return v
    return "TEXT"

def default_clause(col):
    """컬럼 기본값 → SQL DEFAULT 절 문자열 반환."""
    if col.default is not None and col.default.is_scalar:
        dv = col.default.arg
        if dv is None:
            return " DEFAULT NULL"
        if isinstance(dv, bool):
            return f" DEFAULT {int(dv)}"
        if isinstance(dv, str):
            safe = dv.replace("'", "''")
            return f" DEFAULT '{safe}'"
        return f" DEFAULT {dv}"
    # nullable 컬럼이거나 default 없으면 NULL 허용
    return " DEFAULT NULL"

added_cols = 0
for table_name, table_obj in Base.metadata.tables.items():
    if table_name not in existing_tables_after:
        continue  # 방금 create_all로 생성된 테이블은 이미 완전한 스키마
    existing_cols = {c["name"] for c in inspector.get_columns(table_name)}
    for col in table_obj.columns:
        if col.name in existing_cols:
            continue
        sql_type = to_sqlite_type(str(col.type))
        dflt = default_clause(col)
        alter_sql = f"ALTER TABLE {table_name} ADD COLUMN {col.name} {sql_type}{dflt}"
        with engine.connect() as conn:
            conn.execute(text(alter_sql))
            conn.commit()
        print(f"    \033[32m+ {table_name}.{col.name} ({sql_type}{dflt})\033[0m")
        added_cols += 1

if added_cols == 0:
    print("    \033[2m누락 컬럼 없음\033[0m")

print("")
print(f"  \033[32m✅ 마이그레이션 완료\033[0m  "
      f"(신규 테이블: {len(new_tables)}개, 추가 컬럼: {added_cols}개)")
PYEOF
  MIGRATE_EXIT=$?
  set -e

  if [ $MIGRATE_EXIT -ne 0 ]; then
    echo ""
    echo -e "  ${RED}✗ 마이그레이션 실패 (종료 코드: $MIGRATE_EXIT)${NC}"
    echo ""
    echo "  백업에서 복원하려면: han restore"
    exit 1
  fi

  echo ""
  echo -e "  ${DIM}백업 파일: $BACKUP_FILE${NC}"
  echo -e "  ${DIM}복원이 필요하면: han restore${NC}"
  echo ""
}

# ── han open ──────────────────────────────────────────────────────────────────
cmd_open() {
  local URL="http://localhost:5173"
  if command -v xdg-open &>/dev/null; then xdg-open "$URL"
  elif command -v open &>/dev/null; then open "$URL"
  else echo "브라우저에서 직접 접속하세요: $URL"
  fi
}

# ── 명령 라우팅 ───────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  start)                cmd_start "$@" ;;
  stop)                 cmd_stop ;;
  restart)              cmd_restart ;;
  status)               cmd_status ;;
  logs)                 cmd_logs "$@" ;;
  init_check|doctor)    cmd_init_check "$@" ;;
  update)               cmd_update ;;
  reset)                cmd_reset ;;
  backup)               cmd_backup "$@" ;;
  restore)              cmd_restore ;;
  config)               cmd_config "$@" ;;
  diff-env)             cmd_diff_env ;;
  migrate)              cmd_migrate ;;
  path-fix)             cmd_path_fix "$@" ;;
  self-update)          cmd_self_update ;;
  open)                 cmd_open ;;
  --version|-v)         cmd_version ;;
  help|--help|-h)       cmd_help ;;
  *)
    echo -e "${RED}알 수 없는 명령: $COMMAND${NC}"
    echo "  'han help' 로 사용법을 확인하세요."
    exit 1
    ;;
esac
