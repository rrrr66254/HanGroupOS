#!/usr/bin/env bash
# han — HAN Group OS CLI
# 설치: curl -fsSL https://raw.githubusercontent.com/rrrr66254/HanGroupOS/master/install.sh | bash
# 사용: han start | han stop | han status | han logs | han update | han reset | han --version

set -e

HAN_VERSION="30"
HAN_RUN_DIR="$HOME/.han"
HAN_LOG_DIR="$HAN_RUN_DIR/logs"
HAN_PID_BACKEND="$HAN_RUN_DIR/backend.pid"
HAN_PID_FRONTEND="$HAN_RUN_DIR/frontend.pid"
HAN_CONFIG="$HAN_RUN_DIR/config"

# ── 색상 ──────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p "$HAN_RUN_DIR" "$HAN_LOG_DIR"

# ── HAN_DIR 결정 ──────────────────────────────────────────────────────────────
if [ -f "$HAN_CONFIG" ]; then
  # shellcheck source=/dev/null
  source "$HAN_CONFIG"
fi

# 스크립트 자체 위치 기준으로도 찾기 (직접 실행 시)
if [ -z "$HAN_DIR" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$SCRIPT_DIR/start.sh" ]; then
    HAN_DIR="$SCRIPT_DIR"
  elif [ -d "$HOME/HanGroupOS" ]; then
    HAN_DIR="$HOME/HanGroupOS"
  else
    echo -e "${RED}✗ HAN Group OS 설치 경로를 찾을 수 없습니다.${NC}"
    echo ""
    echo "  설치하려면:"
    echo "    curl -fsSL https://raw.githubusercontent.com/rrrr66254/HanGroupOS/master/install.sh | bash"
    exit 1
  fi
  echo "HAN_DIR=\"$HAN_DIR\"" > "$HAN_CONFIG"
fi

# ── 헬퍼 함수 ─────────────────────────────────────────────────────────────────
is_running() {
  local pid_file=$1
  [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

pid_of() {
  local pid_file=$1
  [ -f "$pid_file" ] && cat "$pid_file" || echo ""
}

# ── 명령어 정의 ───────────────────────────────────────────────────────────────

cmd_version() {
  echo "han v${HAN_VERSION} — HAN Group OS CLI"
  echo "설치 경로: $HAN_DIR"
}

cmd_help() {
  echo ""
  echo -e "${BOLD}han — HAN Group OS CLI v${HAN_VERSION}${NC}"
  echo ""
  echo "사용법:"
  echo "  han <명령>"
  echo ""
  echo "명령어:"
  echo -e "  ${GREEN}start${NC}          서버 시작 (포그라운드)"
  echo -e "  ${GREEN}start --daemon${NC}  서버 백그라운드 시작"
  echo -e "  ${GREEN}stop${NC}           서버 종료 (데몬 모드로 실행 중인 경우)"
  echo -e "  ${GREEN}restart${NC}        서버 재시작"
  echo -e "  ${GREEN}status${NC}         실행 상태 확인"
  echo -e "  ${GREEN}logs${NC}           실시간 로그 보기 (Ctrl+C로 종료)"
  echo -e "  ${GREEN}logs backend${NC}   백엔드 로그만 보기"
  echo -e "  ${GREEN}logs frontend${NC}  프론트엔드 로그만 보기"
  echo -e "  ${GREEN}update${NC}         최신 버전으로 업데이트 후 재시작"
  echo -e "  ${GREEN}reset${NC}          DB 초기화 (데이터 삭제) 후 재시작"
  echo -e "  ${GREEN}config${NC}         현재 설정 보기 (.env)"
  echo -e "  ${GREEN}open${NC}           브라우저에서 앱 열기"
  echo -e "  ${GREEN}--version${NC}      버전 정보"
  echo -e "  ${GREEN}help${NC}           이 도움말"
  echo ""
  echo "예시:"
  echo "  han start           # 서버 시작"
  echo "  han start --daemon  # 백그라운드 실행"
  echo "  han stop            # 백그라운드 서버 종료"
  echo "  han status          # 실행 중인지 확인"
  echo "  han logs            # 로그 실시간 보기"
  echo "  han update          # 업데이트"
  echo "  han reset           # DB 초기화"
  echo ""
}

cmd_start() {
  local DAEMON=false
  if [[ "$1" == "--daemon" || "$1" == "-d" ]]; then
    DAEMON=true
  fi

  if is_running "$HAN_PID_BACKEND" || is_running "$HAN_PID_FRONTEND"; then
    echo -e "${YELLOW}⚠ 서버가 이미 실행 중입니다. 'han status' 로 확인하세요.${NC}"
    exit 1
  fi

  if [ "$DAEMON" = true ]; then
    echo -e "${BOLD}HAN Group OS 백그라운드 시작 중...${NC}"
    echo ""

    # 백엔드 데몬
    cd "$HAN_DIR/backend"
    [ ! -d "venv" ] && python3 -m venv venv
    source venv/bin/activate
    pip install -q -r requirements.txt
    nohup uvicorn main:app --host 0.0.0.0 --port 8000 \
      > "$HAN_LOG_DIR/backend.log" 2>&1 &
    echo $! > "$HAN_PID_BACKEND"
    echo -e "  ${GREEN}✓ 백엔드 시작 (PID: $(cat "$HAN_PID_BACKEND"), 로그: ~/.han/logs/backend.log)${NC}"

    # 프론트엔드 데몬
    cd "$HAN_DIR/frontend"
    [ ! -d "node_modules" ] && npm install --silent
    nohup npm run dev \
      > "$HAN_LOG_DIR/frontend.log" 2>&1 &
    echo $! > "$HAN_PID_FRONTEND"
    echo -e "  ${GREEN}✓ 프론트엔드 시작 (PID: $(cat "$HAN_PID_FRONTEND"), 로그: ~/.han/logs/frontend.log)${NC}"

    sleep 2
    echo ""
    echo -e "${GREEN}════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  ✅ HAN Group OS v${HAN_VERSION} 백그라운드 실행 중${NC}"
    echo ""
    echo "  🌐 앱:  http://localhost:5173"
    echo "  🔧 API: http://localhost:8000"
    echo ""
    echo "  han stop    — 종료"
    echo "  han status  — 상태 확인"
    echo "  han logs    — 로그 보기"
    echo -e "${GREEN}════════════════════════════════════════════════${NC}"
  else
    # 포그라운드 — start.sh 그대로 실행
    exec "$HAN_DIR/start.sh"
  fi
}

cmd_stop() {
  local STOPPED=false

  if is_running "$HAN_PID_BACKEND"; then
    kill "$(cat "$HAN_PID_BACKEND")" 2>/dev/null && \
      echo -e "  ${GREEN}✓ 백엔드 종료됨${NC}" || \
      echo -e "  ${RED}✗ 백엔드 종료 실패${NC}"
    rm -f "$HAN_PID_BACKEND"
    STOPPED=true
  fi

  if is_running "$HAN_PID_FRONTEND"; then
    kill "$(cat "$HAN_PID_FRONTEND")" 2>/dev/null && \
      echo -e "  ${GREEN}✓ 프론트엔드 종료됨${NC}" || \
      echo -e "  ${RED}✗ 프론트엔드 종료 실패${NC}"
    rm -f "$HAN_PID_FRONTEND"
    STOPPED=true
  fi

  if [ "$STOPPED" = false ]; then
    echo -e "${YELLOW}⚠ 백그라운드에서 실행 중인 서버가 없습니다.${NC}"
    echo "  (포그라운드 실행 중이라면 Ctrl+C로 종료하세요)"
  fi
}

cmd_restart() {
  echo "서버 재시작 중..."
  cmd_stop
  sleep 1
  cmd_start "--daemon"
}

cmd_status() {
  echo ""
  echo -e "${BOLD}HAN Group OS 상태${NC}"
  echo ""

  if is_running "$HAN_PID_BACKEND"; then
    local pid=$(cat "$HAN_PID_BACKEND")
    echo -e "  백엔드  : ${GREEN}● 실행 중${NC} (PID: $pid) — http://localhost:8000"
  else
    # 백그라운드 PID 파일은 없지만 포트로 확인
    if command -v lsof &>/dev/null && lsof -ti:8000 &>/dev/null; then
      echo -e "  백엔드  : ${GREEN}● 실행 중${NC} (포그라운드 또는 다른 프로세스) — http://localhost:8000"
    else
      echo -e "  백엔드  : ${RED}○ 중지됨${NC}"
    fi
  fi

  if is_running "$HAN_PID_FRONTEND"; then
    local pid=$(cat "$HAN_PID_FRONTEND")
    echo -e "  프론트  : ${GREEN}● 실행 중${NC} (PID: $pid) — http://localhost:5173"
  else
    if command -v lsof &>/dev/null && lsof -ti:5173 &>/dev/null; then
      echo -e "  프론트  : ${GREEN}● 실행 중${NC} (포그라운드 또는 다른 프로세스) — http://localhost:5173"
    else
      echo -e "  프론트  : ${RED}○ 중지됨${NC}"
    fi
  fi

  echo ""
  echo "  설치 경로 : $HAN_DIR"
  echo "  버전      : v${HAN_VERSION}"
  if [ -f "$HAN_DIR/backend/.env" ]; then
    local provider
    provider=$(grep "^DEFAULT_PROVIDER=" "$HAN_DIR/backend/.env" | cut -d= -f2)
    echo "  AI 프로바이더 : ${provider:-미설정}"
  fi
  echo ""
}

cmd_logs() {
  local TARGET="${1:-all}"
  case "$TARGET" in
    backend)
      if [ -f "$HAN_LOG_DIR/backend.log" ]; then
        echo -e "${CYAN}[백엔드 로그] Ctrl+C로 종료${NC}"
        tail -f "$HAN_LOG_DIR/backend.log"
      else
        echo -e "${YELLOW}백엔드 로그 파일이 없습니다. 'han start --daemon'으로 실행하면 로그가 기록됩니다.${NC}"
      fi
      ;;
    frontend)
      if [ -f "$HAN_LOG_DIR/frontend.log" ]; then
        echo -e "${CYAN}[프론트엔드 로그] Ctrl+C로 종료${NC}"
        tail -f "$HAN_LOG_DIR/frontend.log"
      else
        echo -e "${YELLOW}프론트엔드 로그 파일이 없습니다. 'han start --daemon'으로 실행하면 로그가 기록됩니다.${NC}"
      fi
      ;;
    *)
      # 두 로그 동시에 보기
      local FILES=()
      [ -f "$HAN_LOG_DIR/backend.log" ]  && FILES+=("$HAN_LOG_DIR/backend.log")
      [ -f "$HAN_LOG_DIR/frontend.log" ] && FILES+=("$HAN_LOG_DIR/frontend.log")
      if [ ${#FILES[@]} -eq 0 ]; then
        echo -e "${YELLOW}로그 파일이 없습니다. 'han start --daemon'으로 실행하면 로그가 기록됩니다.${NC}"
      else
        echo -e "${CYAN}[전체 로그] Ctrl+C로 종료${NC}"
        tail -f "${FILES[@]}"
      fi
      ;;
  esac
}

cmd_update() {
  echo -e "${BOLD}HAN Group OS 업데이트 중...${NC}"
  echo ""

  if ! command -v git &>/dev/null; then
    echo -e "${RED}✗ git이 설치되지 않았습니다.${NC}"
    exit 1
  fi

  cmd_stop 2>/dev/null || true

  cd "$HAN_DIR"
  echo "  ✓ git pull origin master..."
  git pull origin master

  echo "  ✓ 백엔드 의존성 업데이트..."
  cd "$HAN_DIR/backend"
  [ -d "venv" ] && source venv/bin/activate && pip install -q -r requirements.txt

  echo "  ✓ 프론트엔드 의존성 업데이트..."
  cd "$HAN_DIR/frontend"
  npm install --silent

  echo ""
  echo -e "${GREEN}✓ 업데이트 완료!${NC}"
  echo ""
  read -r -p "  지금 바로 시작하시겠습니까? (Y/n) > " START_NOW
  START_NOW="${START_NOW:-Y}"
  if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
    cmd_start "--daemon"
  fi
}

cmd_reset() {
  echo -e "${YELLOW}⚠ 경고: 모든 데이터(DB)가 삭제됩니다.${NC}"
  read -r -p "  계속하시겠습니까? (y/N) > " CONFIRM
  if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "  취소됩니다."
    exit 0
  fi

  cmd_stop 2>/dev/null || true

  local DB_PATH="$HAN_DIR/backend/han_group.db"
  if [ -f "$DB_PATH" ]; then
    rm "$DB_PATH"
    echo -e "  ${GREEN}✓ 데이터베이스 삭제됨${NC}"
  else
    echo -e "  ${YELLOW}⚠ DB 파일이 없습니다 (이미 초기화 상태)${NC}"
  fi

  echo "  서버를 재시작하면 DB가 자동으로 재생성됩니다."
  echo ""
  read -r -p "  지금 바로 시작하시겠습니까? (Y/n) > " START_NOW
  START_NOW="${START_NOW:-Y}"
  if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
    cmd_start "--daemon"
  fi
}

cmd_config() {
  local ENV_FILE="$HAN_DIR/backend/.env"
  if [ -f "$ENV_FILE" ]; then
    echo ""
    echo -e "${BOLD}현재 설정 ($ENV_FILE)${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    # API 키는 마스킹하여 표시
    while IFS= read -r line; do
      if [[ "$line" =~ _API_KEY= && ! "$line" =~ =$ ]]; then
        local key="${line%%=*}"
        local val="${line##*=}"
        local masked="${val:0:8}****${val: -4}"
        echo "  $key=$masked"
      else
        echo "  $line"
      fi
    done < "$ENV_FILE"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "  수정: nano $ENV_FILE"
    echo "  수정 후 'han restart'로 재시작하세요."
    echo ""
  else
    echo -e "${YELLOW}⚠ .env 파일이 없습니다. 'han start'로 먼저 실행하세요.${NC}"
  fi
}

cmd_open() {
  local URL="http://localhost:5173"
  if command -v xdg-open &>/dev/null; then
    xdg-open "$URL"
  elif command -v open &>/dev/null; then
    open "$URL"
  else
    echo "브라우저에서 직접 접속하세요: $URL"
  fi
}

# ── 명령 라우팅 ───────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  start)          cmd_start "$@" ;;
  stop)           cmd_stop ;;
  restart)        cmd_restart ;;
  status)         cmd_status ;;
  logs)           cmd_logs "$@" ;;
  update)         cmd_update ;;
  reset)          cmd_reset ;;
  config)         cmd_config ;;
  open)           cmd_open ;;
  --version|-v)   cmd_version ;;
  help|--help|-h) cmd_help ;;
  *)
    echo -e "${RED}알 수 없는 명령: $COMMAND${NC}"
    echo "  'han help' 로 사용법을 확인하세요."
    exit 1
    ;;
esac
