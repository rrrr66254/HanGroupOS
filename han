#!/usr/bin/env bash
# han — HAN Group OS CLI
# 설치: curl -fsSL https://raw.githubusercontent.com/rrrr66254/HanGroupOS/master/install.sh | bash
# 사용: han <명령>  |  han help 로 전체 목록 확인

set -e

HAN_VERSION="30"
HAN_RUN_DIR="$HOME/.han"
HAN_LOG_DIR="$HAN_RUN_DIR/logs"
HAN_BACKUP_DIR="$HAN_RUN_DIR/backups"
HAN_PID_BACKEND="$HAN_RUN_DIR/backend.pid"
HAN_PID_FRONTEND="$HAN_RUN_DIR/frontend.pid"
HAN_CONFIG="$HAN_RUN_DIR/config"

# ── 색상 ──────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

mkdir -p "$HAN_RUN_DIR" "$HAN_LOG_DIR" "$HAN_BACKUP_DIR"

# ── HAN_DIR 결정 ──────────────────────────────────────────────────────────────
if [ -f "$HAN_CONFIG" ]; then
  # shellcheck source=/dev/null
  source "$HAN_CONFIG"
fi

if [ -z "$HAN_DIR" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$SCRIPT_DIR/start.sh" ]; then
    HAN_DIR="$SCRIPT_DIR"
  elif [ -d "$HOME/HanGroupOS" ]; then
    HAN_DIR="$HOME/HanGroupOS"
  else
    echo -e "${RED}✗ HAN Group OS 설치 경로를 찾을 수 없습니다.${NC}"
    echo ""
    echo "  설치하려면:"
    echo "    curl -fsSL https://raw.githubusercontent.com/rrrr66254/HanGroupOS/master/install.sh | bash"
    exit 1
  fi
  echo "HAN_DIR=\"$HAN_DIR\"" > "$HAN_CONFIG"
fi

# ── OS 감지 ───────────────────────────────────────────────────────────────────
detect_os() {
  if [[ "$OSTYPE" == "darwin"* ]]; then echo "macos"
  elif grep -qi microsoft /proc/version 2>/dev/null; then echo "wsl"
  elif [[ "$OSTYPE" == "linux-gnu"* ]]; then echo "linux"
  else echo "unknown"
  fi
}
OS=$(detect_os)

# ── 공통 헬퍼 ─────────────────────────────────────────────────────────────────
is_running() {
  local pid_file=$1
  [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

port_in_use() {
  local port=$1
  if command -v lsof &>/dev/null; then
    lsof -ti:"$port" &>/dev/null
  elif command -v ss &>/dev/null; then
    ss -tlnp 2>/dev/null | grep -q ":$port "
  fi
}

