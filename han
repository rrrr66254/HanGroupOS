#!/usr/bin/env bash
# han — HAN Group OS CLI
# 설치: curl -fsSL https://raw.githubusercontent.com/rrrr66254/HanGroupOS/master/install.sh | bash
# 사용: han <명령>  |  han help 로 전체 목록 확인

set -e

HAN_VERSION="30"
HAN_RUN_DIR="$HOME/.han"
HAN_LOG_DIR="$HAN_RUN_DIR/logs"
HAN_BACKUP_DIR="$HAN_RUN_DIR/backups"
HAN_PID_BACKEND="$HAN_RUN_DIR/backend.pid"
HAN_PID_FRONTEND="$HAN_RUN_DIR/frontend.pid"
HAN_CONFIG="$HAN_RUN_DIR/config"

# ── 색상 ──────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

mkdir -p "$HAN_RUN_DIR" "$HAN_LOG_DIR" "$HAN_BACKUP_DIR"

# ── HAN_DIR 결정 ──────────────────────────────────────────────────────────────
if [ -f "$HAN_CONFIG" ]; then
  # shellcheck source=/dev/null
  source "$HAN_CONFIG"
fi

if [ -z "$HAN_DIR" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$SCRIPT_DIR/start.sh" ]; then
    HAN_DIR="$SCRIPT_DIR"
  elif [ -d "$HOME/HanGroupOS" ]; then
    HAN_DIR="$HOME/HanGroupOS"
  else
    echo -e "${RED}✗ HAN Group OS 설치 경로를 찾을 수 없습니다.${NC}"
    echo ""
    echo "  설치하려면:"
    echo "    curl -fsSL https://raw.githubusercontent.com/rrrr66254/HanGroupOS/master/install.sh | bash"
    exit 1
  fi
  echo "HAN_DIR=\"$HAN_DIR\"" > "$HAN_CONFIG"
fi

# ── OS 감지 ───────────────────────────────────────────────────────────────────
detect_os() {
  if [[ "$OSTYPE" == "darwin"* ]]; then echo "macos"
  elif grep -qi microsoft /proc/version 2>/dev/null; then echo "wsl"
  elif [[ "$OSTYPE" == "linux-gnu"* ]]; then echo "linux"
  else echo "unknown"
  fi
}
OS=$(detect_os)

# ── 공통 헬퍼 ─────────────────────────────────────────────────────────────────
is_running() {
  local pid_file=$1
  [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

port_in_use() {
  local port=$1
  if command -v lsof &>/dev/null; then
    lsof -ti:"$port" &>/dev/null
  elif command -v ss &>/dev/null; then
    ss -tlnp 2>/dev/null | grep -q ":$port "
  fi
}

# ── han help ──────────────────────────────────────────────────────────────────
cmd_help() {
  echo ""
  echo -e "${BOLD}han — HAN Group OS CLI v${HAN_VERSION}${NC}"
  echo ""
  echo "사용법:  han <명령> [옵션]"
  echo ""
  echo -e "${BOLD}서버 관리${NC}"
  echo -e "  ${GREEN}start${NC}              서버 시작 (포그라운드, Ctrl+C로 종료)"
  echo -e "  ${GREEN}start --daemon${NC}     백그라운드 시작"
  echo -e "  ${GREEN}stop${NC}               백그라운드 서버 종료"
  echo -e "  ${GREEN}restart${NC}            재시작"
  echo -e "  ${GREEN}status${NC}             실행 상태 + 버전 + 설정 요약"
  echo ""
  echo -e "${BOLD}로그 & 진단${NC}"
  echo -e "  ${GREEN}logs${NC}               전체 로그 실시간 보기"
  echo -e "  ${GREEN}logs backend${NC}       백엔드 로그만"
  echo -e "  ${GREEN}logs frontend${NC}      프론트엔드 로그만"
  echo -e "  ${GREEN}init_check${NC}         환경 사전 점검 (Python/Node/포트/설정)"
  echo ""
  echo -e "${BOLD}업데이트 & 유지보수${NC}"
  echo -e "  ${GREEN}update${NC}             GitHub 업데이트 확인 후 적용"
  echo -e "  ${GREEN}reset${NC}              DB 초기화 후 재시작"
  echo -e "  ${GREEN}backup${NC}             DB 백업"
  echo -e "  ${GREEN}restore${NC}            DB 백업 복원"
  echo ""
  echo -e "${BOLD}설정 & 기타${NC}"
  echo -e "  ${GREEN}config${NC}             현재 .env 설정 보기 (API 키 마스킹)"
  echo -e "  ${GREEN}open${NC}               브라우저에서 앱 열기"
  echo -e "  ${GREEN}--version${NC}          버전 정보"
  echo -e "  ${GREEN}help${NC}               이 도움말"
  echo ""
  echo -e "${DIM}설치 경로: $HAN_DIR${NC}"
  echo ""
}

# ── han --version ─────────────────────────────────────────────────────────────
cmd_version() {
  echo "han v${HAN_VERSION} — HAN Group OS CLI"
  echo "설치 경로: $HAN_DIR"
  if command -v git &>/dev/null && [ -d "$HAN_DIR/.git" ]; then
    local commit
    commit=$(git -C "$HAN_DIR" rev-parse --short HEAD 2>/dev/null || echo "알 수 없음")
    echo "커밋: $commit"
  fi
}

# ── han init_check ────────────────────────────────────────────────────────────
cmd_init_check() {
  local FAIL=0

  echo ""
  echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${BOLD}║     han init_check — 환경 사전 점검          ║${NC}"
  echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
  echo ""

  # ─ 섹션 1: 필수 프로그램 ───────────────────────────────────────────────────
  echo -e "${BOLD}[ 필수 프로그램 ]${NC}"
  echo ""

  # Python
  local py_ok=false
  if command -v python3 &>/dev/null; then
    local py_ver py_major py_minor
    py_ver=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    py_major=$(python3 -c "import sys; print(sys.version_info.major)")
    py_minor=$(python3 -c "import sys; print(sys.version_info.minor)")
    if [[ $py_major -ge 3 && $py_minor -ge 9 ]]; then
      echo -e "  ${GREEN}✓ Python $py_ver${NC}"
      py_ok=true
    else
      echo -e "  ${RED}✗ Python $py_ver${NC}  →  3.9 이상 필요"
      echo ""
      _install_guide_python
      FAIL=1
    fi
  else
    echo -e "  ${RED}✗ Python3 미설치${NC}"
    echo ""
    _install_guide_python
    FAIL=1
  fi

  # pip
  if $py_ok; then
    if python3 -m pip --version &>/dev/null 2>&1; then
      local pip_ver
      pip_ver=$(python3 -m pip --version | awk '{print $2}')
      echo -e "  ${GREEN}✓ pip $pip_ver${NC}"
    else
      echo -e "  ${RED}✗ pip 미설치${NC}"
      echo ""
      _install_guide_pip
      FAIL=1
    fi
  fi

  # Node.js
  local node_ok=false
  if command -v node &>/dev/null; then
    local node_ver node_major
    node_ver=$(node -v | sed 's/v//')
    node_major=$(echo "$node_ver" | cut -d. -f1)
    if [[ $node_major -ge 18 ]]; then
      echo -e "  ${GREEN}✓ Node.js v$node_ver${NC}"
      node_ok=true
    else
      echo -e "  ${RED}✗ Node.js v$node_ver${NC}  →  v18 이상 필요"
      echo ""
      _install_guide_node
      FAIL=1
    fi
  else
    echo -e "  ${RED}✗ Node.js 미설치${NC}"
    echo ""
    _install_guide_node
    FAIL=1
  fi

  # npm
  if $node_ok; then
    if command -v npm &>/dev/null; then
      local npm_ver
      npm_ver=$(npm --version)
      echo -e "  ${GREEN}✓ npm $npm_ver${NC}"
    else
      echo -e "  ${RED}✗ npm 미설치${NC}  →  Node.js 재설치 필요"
      FAIL=1
    fi
  fi

  # git
  if command -v git &>/dev/null; then
    local git_ver
    git_ver=$(git --version | awk '{print $3}')
    echo -e "  ${GREEN}✓ git $git_ver${NC}"
  else
    echo -e "  ${YELLOW}△ git 미설치${NC}  →  han update 명령을 사용하려면 필요"
    echo ""
    case $OS in
      macos)     echo "    brew install git" ;;
      wsl|linux) echo "    sudo apt install -y git" ;;
      *)         echo "    https://git-scm.com/downloads" ;;
    esac
    echo ""
  fi

  # ─ 섹션 2: 포트 가용성 ────────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}[ 포트 가용성 ]${NC}"
  echo ""

  for PORT in 8000 5173; do
    local role
    [[ $PORT -eq 8000 ]] && role="백엔드" || role="프론트엔드"
    if port_in_use $PORT; then
      local proc=""
      if command -v lsof &>/dev/null; then
        proc=$(lsof -ti:"$PORT" 2>/dev/null | head -1 | xargs -I{} ps -p {} -o comm= 2>/dev/null || true)
      fi
      echo -e "  ${YELLOW}△ 포트 $PORT ($role) 사용 중${NC}${proc:+ — $proc}"
      echo ""
      case $OS in
        macos)     echo "    kill -9 \$(lsof -ti:$PORT)  # 강제 종료" ;;
        wsl|linux) echo "    fuser -k ${PORT}/tcp        # 강제 종료" ;;
      esac
      echo ""
    else
      echo -e "  ${GREEN}✓ 포트 $PORT ($role) 사용 가능${NC}"
    fi
  done

  # ─ 섹션 3: 설정 파일 ──────────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}[ 설정 파일 ]${NC}"
  echo ""

  local env_file="$HAN_DIR/backend/.env"
  if [ -f "$env_file" ]; then
    echo -e "  ${GREEN}✓ .env 존재${NC}"
    local provider
    provider=$(grep "^DEFAULT_PROVIDER=" "$env_file" | cut -d= -f2)
    echo -e "  ${GREEN}✓ AI 프로바이더: ${provider:-미설정}${NC}"

    # Ollama 연결 확인
    if [[ "$provider" == "ollama" ]]; then
      local ollama_url
      ollama_url=$(grep "^OLLAMA_BASE_URL=" "$env_file" | cut -d= -f2)
      ollama_url="${ollama_url:-http://localhost:11434}"
      if curl -sf --max-time 2 "$ollama_url/api/tags" &>/dev/null; then
        echo -e "  ${GREEN}✓ Ollama 서버 응답 중 ($ollama_url)${NC}"
      else
        echo -e "  ${RED}✗ Ollama 서버 응답 없음 ($ollama_url)${NC}"
        echo ""
        echo "    Ollama가 설치되어 있다면 실행하세요:"
        echo "    ollama serve"
        echo ""
        echo "    설치가 안 되어 있다면:"
        echo "    https://ollama.com/download"
        echo ""
        FAIL=1
      fi
    fi

    # Anthropic/OpenAI/Gemini 키 존재 여부 확인
    for KEY_NAME in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY; do
      local key_val
      key_val=$(grep "^${KEY_NAME}=" "$env_file" | cut -d= -f2)
      if [[ -n "$key_val" ]]; then
        echo -e "  ${GREEN}✓ ${KEY_NAME} 설정됨${NC} (${key_val:0:8}****)"
      fi
    done
  else
    echo -e "  ${YELLOW}△ .env 없음${NC}  →  'han start' 실행 시 자동 생성됩니다"
  fi

  # ─ 섹션 4: 프로젝트 파일 ─────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}[ 프로젝트 파일 ]${NC}"
  echo ""

  local checks=(
    "$HAN_DIR/backend/main.py:FastAPI 진입점"
    "$HAN_DIR/backend/requirements.txt:Python 의존성"
    "$HAN_DIR/frontend/package.json:Node.js 패키지"
    "$HAN_DIR/start.sh:실행 스크립트"
  )
  for entry in "${checks[@]}"; do
    local path="${entry%%:*}"
    local label="${entry##*:}"
    if [ -f "$path" ]; then
      echo -e "  ${GREEN}✓ $label${NC}"
    else
      echo -e "  ${RED}✗ $label 없음${NC} ($path)"
      FAIL=1
    fi
  done

  # venv 체크
  if [ -d "$HAN_DIR/backend/venv" ]; then
    echo -e "  ${GREEN}✓ Python 가상환경 (backend/venv)${NC}"
  else
    echo -e "  ${YELLOW}△ Python 가상환경 없음${NC}  →  'han start' 시 자동 생성됩니다"
  fi

  # node_modules 체크
  if [ -d "$HAN_DIR/frontend/node_modules" ]; then
    echo -e "  ${GREEN}✓ node_modules 설치됨${NC}"
  else
    echo -e "  ${YELLOW}△ node_modules 없음${NC}  →  'han start' 시 자동 설치됩니다"
  fi

  # ─ 결과 ──────────────────────────────────────────────────────────────────
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  if [[ $FAIL -eq 0 ]]; then
    echo -e "  ${GREEN}✅ 모든 필수 요구사항이 충족되었습니다.${NC}"
    echo -e "  ${GREEN}   'han start' 로 서버를 시작하세요.${NC}"
  else
    echo -e "  ${RED}✗ 위 항목을 해결한 후 다시 실행하세요.${NC}"
    echo "    han init_check"
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  return $FAIL
}

# ── 설치 가이드 서브함수 ───────────────────────────────────────────────────────
_install_guide_python() {
  echo -e "  ${YELLOW}▶ Python 3.11 설치 방법:${NC}"
  case $OS in
    macos)
      echo "    # Homebrew가 없다면:"
      echo "    /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
      echo "    # Python 설치:"
      echo "    brew install python@3.11"
      ;;
    wsl|linux)
      echo "    sudo apt update"
      echo "    sudo apt install -y python3.11 python3.11-venv python3-pip"
      ;;
    *)
      echo "    1. https://www.python.org/downloads/ 접속"
      echo "    2. Python 3.11.x 다운로드 및 설치"
      echo "    3. ☑ 'Add Python to PATH' 반드시 체크"
      ;;
  esac
  echo ""
}

_install_guide_pip() {
  echo -e "  ${YELLOW}▶ pip 설치 방법:${NC}"
  case $OS in
    wsl|linux) echo "    sudo apt install -y python3-pip" ;;
    *)         echo "    python3 -m ensurepip --upgrade" ;;
  esac
  echo ""
}

_install_guide_node() {
  echo -e "  ${YELLOW}▶ Node.js 20 LTS 설치 방법:${NC}"
  case $OS in
    macos)
      echo "    # 방법 1 — nvm (권장):"
      echo "    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash"
      echo "    source ~/.zshrc  # 또는 source ~/.bashrc"
      echo "    nvm install 20 && nvm use 20"
      echo ""
      echo "    # 방법 2 — Homebrew:"
      echo "    brew install node@20"
      ;;
    wsl|linux)
      echo "    # nvm으로 설치 (권장):"
      echo "    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash"
      echo "    source ~/.bashrc"
      echo "    nvm install 20 && nvm use 20"
      echo ""
      echo "    # 또는 nodesource apt:"
      echo "    curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -"
      echo "    sudo apt install -y nodejs"
      ;;
    *)
      echo "    1. https://nodejs.org 접속"
      echo "    2. 'LTS' 버전 다운로드 및 설치"
      ;;
  esac
  echo ""
}

# ── han start ─────────────────────────────────────────────────────────────────
cmd_start() {
  local DAEMON=false
  [[ "$1" == "--daemon" || "$1" == "-d" ]] && DAEMON=true

  if is_running "$HAN_PID_BACKEND" || is_running "$HAN_PID_FRONTEND"; then
    echo -e "${YELLOW}⚠ 서버가 이미 실행 중입니다. 'han status' 로 확인하세요.${NC}"
    exit 1
  fi

  if [ "$DAEMON" = true ]; then
    echo -e "${BOLD}HAN Group OS 백그라운드 시작 중...${NC}"
    echo ""

    cd "$HAN_DIR/backend"
    [ ! -d "venv" ] && python3 -m venv venv
    source venv/bin/activate
    pip install -q -r requirements.txt
    nohup uvicorn main:app --host 0.0.0.0 --port 8000 \
      > "$HAN_LOG_DIR/backend.log" 2>&1 &
    echo $! > "$HAN_PID_BACKEND"
    echo -e "  ${GREEN}✓ 백엔드 시작${NC} (PID: $(cat "$HAN_PID_BACKEND"))"

    cd "$HAN_DIR/frontend"
    [ ! -d "node_modules" ] && npm install --silent
    nohup npm run dev \
      > "$HAN_LOG_DIR/frontend.log" 2>&1 &
    echo $! > "$HAN_PID_FRONTEND"
    echo -e "  ${GREEN}✓ 프론트엔드 시작${NC} (PID: $(cat "$HAN_PID_FRONTEND"))"

    sleep 2
    echo ""
    echo -e "${GREEN}════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  ✅ HAN Group OS v${HAN_VERSION} 백그라운드 실행 중${NC}"
    echo ""
    echo "  🌐 앱:  http://localhost:5173"
    echo "  🔧 API: http://localhost:8000"
    echo ""
    echo "  han stop    — 종료    han status — 상태 확인"
    echo "  han logs    — 로그    han open   — 브라우저"
    echo -e "${GREEN}════════════════════════════════════════════════${NC}"
  else
    exec "$HAN_DIR/start.sh"
  fi
}

# ── han stop ──────────────────────────────────────────────────────────────────
cmd_stop() {
  local STOPPED=false

  if is_running "$HAN_PID_BACKEND"; then
    kill "$(cat "$HAN_PID_BACKEND")" 2>/dev/null \
      && echo -e "  ${GREEN}✓ 백엔드 종료됨${NC}" \
      || echo -e "  ${RED}✗ 백엔드 종료 실패${NC}"
    rm -f "$HAN_PID_BACKEND"
    STOPPED=true
  fi

  if is_running "$HAN_PID_FRONTEND"; then
    kill "$(cat "$HAN_PID_FRONTEND")" 2>/dev/null \
      && echo -e "  ${GREEN}✓ 프론트엔드 종료됨${NC}" \
      || echo -e "  ${RED}✗ 프론트엔드 종료 실패${NC}"
    rm -f "$HAN_PID_FRONTEND"
    STOPPED=true
  fi

  if [ "$STOPPED" = false ]; then
    echo -e "${YELLOW}⚠ 백그라운드에서 실행 중인 서버가 없습니다.${NC}"
    echo "  (포그라운드 실행 중이라면 Ctrl+C로 종료하세요)"
  fi
}

# ── han restart ───────────────────────────────────────────────────────────────
cmd_restart() {
  echo "서버 재시작 중..."
  cmd_stop
  sleep 1
  cmd_start "--daemon"
}

# ── han status ────────────────────────────────────────────────────────────────
cmd_status() {
  echo ""
  echo -e "${BOLD}HAN Group OS 상태${NC}"
  echo ""

  for spec in "8000:백엔드:$HAN_PID_BACKEND" "5173:프론트엔드:$HAN_PID_FRONTEND"; do
    local port="${spec%%:*}"; spec="${spec#*:}"
    local label="${spec%%:*}"
    local pid_file="${spec##*:}"

    if is_running "$pid_file"; then
      echo -e "  $label : ${GREEN}● 실행 중${NC} (PID: $(cat "$pid_file")) — http://localhost:$port"
    elif port_in_use "$port"; then
      echo -e "  $label : ${GREEN}● 실행 중${NC} (포그라운드) — http://localhost:$port"
    else
      echo -e "  $label : ${RED}○ 중지됨${NC}"
    fi
  done

  echo ""
  echo "  설치 경로 : $HAN_DIR"
  echo "  CLI 버전  : v${HAN_VERSION}"

  if command -v git &>/dev/null && [ -d "$HAN_DIR/.git" ]; then
    local commit
    commit=$(git -C "$HAN_DIR" rev-parse --short HEAD 2>/dev/null || echo "알 수 없음")
    echo "  커밋      : $commit"
  fi

  if [ -f "$HAN_DIR/backend/.env" ]; then
    local provider
    provider=$(grep "^DEFAULT_PROVIDER=" "$HAN_DIR/backend/.env" | cut -d= -f2)
    echo "  AI 프로바이더 : ${provider:-미설정}"
  fi
  echo ""
}

# ── han logs ──────────────────────────────────────────────────────────────────
cmd_logs() {
  local TARGET="${1:-all}"
  case "$TARGET" in
    backend)
      if [ -f "$HAN_LOG_DIR/backend.log" ]; then
        echo -e "${CYAN}[백엔드 로그] Ctrl+C로 종료${NC}"
        tail -f "$HAN_LOG_DIR/backend.log"
      else
        echo -e "${YELLOW}백엔드 로그 없음. 'han start --daemon'으로 실행하면 기록됩니다.${NC}"
      fi
      ;;
    frontend)
      if [ -f "$HAN_LOG_DIR/frontend.log" ]; then
        echo -e "${CYAN}[프론트엔드 로그] Ctrl+C로 종료${NC}"
        tail -f "$HAN_LOG_DIR/frontend.log"
      else
        echo -e "${YELLOW}프론트엔드 로그 없음. 'han start --daemon'으로 실행하면 기록됩니다.${NC}"
      fi
      ;;
    *)
      local FILES=()
      [ -f "$HAN_LOG_DIR/backend.log" ]  && FILES+=("$HAN_LOG_DIR/backend.log")
      [ -f "$HAN_LOG_DIR/frontend.log" ] && FILES+=("$HAN_LOG_DIR/frontend.log")
      if [ ${#FILES[@]} -eq 0 ]; then
        echo -e "${YELLOW}로그 없음. 'han start --daemon'으로 실행하면 기록됩니다.${NC}"
      else
        echo -e "${CYAN}[전체 로그] Ctrl+C로 종료${NC}"
        tail -f "${FILES[@]}"
      fi
      ;;
  esac
}

# ── han update ────────────────────────────────────────────────────────────────
cmd_update() {
  echo ""
  echo -e "${BOLD}han update — GitHub 업데이트 확인${NC}"
  echo ""

  if ! command -v git &>/dev/null; then
    echo -e "${RED}✗ git이 설치되지 않았습니다.${NC}"
    echo ""
    case $OS in
      macos)     echo "    brew install git" ;;
      wsl|linux) echo "    sudo apt install -y git" ;;
      *)         echo "    https://git-scm.com/downloads" ;;
    esac
    exit 1
  fi

  if [ ! -d "$HAN_DIR/.git" ]; then
    echo -e "${RED}✗ git 저장소가 아닙니다: $HAN_DIR${NC}"
    echo "  install.sh 로 설치한 경우에만 update가 동작합니다."
    exit 1
  fi

  cd "$HAN_DIR"

  # 네트워크 연결 확인
  echo -e "  ${DIM}원격 저장소 확인 중...${NC}"
  if ! git fetch origin master --quiet 2>/dev/null; then
    echo -e "${RED}✗ 원격 저장소에 연결할 수 없습니다. 네트워크를 확인하세요.${NC}"
    exit 1
  fi

  local LOCAL REMOTE BEHIND AHEAD
  LOCAL=$(git rev-parse HEAD)
  REMOTE=$(git rev-parse origin/master)
  BEHIND=$(git rev-list HEAD..origin/master --count 2>/dev/null || echo "0")
  AHEAD=$(git rev-list origin/master..HEAD --count 2>/dev/null || echo "0")

  if [ "$LOCAL" = "$REMOTE" ]; then
    echo -e "  ${GREEN}✓ 이미 최신 버전입니다.${NC}"
    echo ""
    echo -e "  ${DIM}현재 커밋: $(git rev-parse --short HEAD)${NC}"
    echo ""
    exit 0
  fi

  if [ "$BEHIND" -gt 0 ]; then
    echo -e "  ${CYAN}↓ 새 업데이트 ${BEHIND}개 커밋이 있습니다.${NC}"
    echo ""
    echo -e "${BOLD}  변경 내역:${NC}"
    git log HEAD..origin/master --oneline --no-walk=unsorted 2>/dev/null \
      | head -20 \
      | while IFS= read -r line; do
          echo "    $line"
        done
    echo ""
  fi

  if [ "$AHEAD" -gt 0 ]; then
    echo -e "  ${YELLOW}⚠ 로컬에 ${AHEAD}개의 커밋이 원격보다 앞서 있습니다.${NC}"
    echo ""
  fi

  # 업데이트 적용 여부 확인
  if [ -t 0 ]; then
    read -r -p "  업데이트를 적용하시겠습니까? (Y/n) > " APPLY
    APPLY="${APPLY:-Y}"
    if [[ ! "$APPLY" =~ ^[Yy]$ ]]; then
      echo "  취소됩니다."
      exit 0
    fi
  fi

  echo ""
  echo -e "  ${BOLD}업데이트 적용 중...${NC}"

  # 실행 중이면 먼저 종료
  if is_running "$HAN_PID_BACKEND" || is_running "$HAN_PID_FRONTEND"; then
    echo "  ✓ 실행 중인 서버 종료..."
    cmd_stop 2>/dev/null || true
    sleep 1
  fi

  # DB 자동 백업
  local DB_PATH="$HAN_DIR/backend/han_group.db"
  if [ -f "$DB_PATH" ]; then
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    cp "$DB_PATH" "$HAN_BACKUP_DIR/han_group_before_update_${ts}.db"
    echo -e "  ${GREEN}✓ DB 자동 백업됨${NC} (before_update_${ts}.db)"
  fi

  # git pull
  echo "  ✓ git pull origin master..."
  git pull origin master

  # 의존성 업데이트
  echo "  ✓ 백엔드 의존성 업데이트..."
  cd "$HAN_DIR/backend"
  if [ -d "venv" ]; then
    source venv/bin/activate
    pip install -q -r requirements.txt
  fi

  echo "  ✓ 프론트엔드 의존성 업데이트..."
  cd "$HAN_DIR/frontend"
  npm install --silent

  # han CLI 자신도 업데이트
  local CLI_PATH
  CLI_PATH=$(command -v han 2>/dev/null || echo "")
  if [ -n "$CLI_PATH" ] && [ "$CLI_PATH" != "$HAN_DIR/han" ]; then
    cp "$HAN_DIR/han" "$CLI_PATH"
    chmod +x "$CLI_PATH"
    echo -e "  ${GREEN}✓ han CLI 자신도 업데이트됨${NC}"
  fi

  echo ""
  echo -e "${GREEN}  ✅ 업데이트 완료!${NC}"
  local new_commit
  new_commit=$(git -C "$HAN_DIR" rev-parse --short HEAD 2>/dev/null || echo "알 수 없음")
  echo -e "  ${DIM}커밋: $new_commit${NC}"
  echo ""

  if [ -t 0 ]; then
    read -r -p "  지금 바로 서버를 시작하시겠습니까? (Y/n) > " START_NOW
    START_NOW="${START_NOW:-Y}"
    if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
      cmd_start "--daemon"
    fi
  fi
}

# ── han reset ─────────────────────────────────────────────────────────────────
cmd_reset() {
  echo -e "${YELLOW}⚠ 경고: 모든 데이터(DB)가 삭제됩니다.${NC}"
  read -r -p "  계속하시겠습니까? (y/N) > " CONFIRM
  if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "  취소됩니다."
    exit 0
  fi

  cmd_stop 2>/dev/null || true

  local DB_PATH="$HAN_DIR/backend/han_group.db"
  if [ -f "$DB_PATH" ]; then
    # 리셋 전 자동 백업
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    cp "$DB_PATH" "$HAN_BACKUP_DIR/han_group_before_reset_${ts}.db"
    echo -e "  ${GREEN}✓ DB 백업됨${NC} (before_reset_${ts}.db)"
    rm "$DB_PATH"
    echo -e "  ${GREEN}✓ 데이터베이스 삭제됨${NC}"
  else
    echo -e "  ${YELLOW}⚠ DB 파일이 없습니다 (이미 초기화 상태)${NC}"
  fi

  echo ""
  read -r -p "  지금 바로 시작하시겠습니까? (Y/n) > " START_NOW
  START_NOW="${START_NOW:-Y}"
  if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
    cmd_start "--daemon"
  fi
}

# ── han backup ────────────────────────────────────────────────────────────────
cmd_backup() {
  local DB_PATH="$HAN_DIR/backend/han_group.db"

  if [ ! -f "$DB_PATH" ]; then
    echo -e "${YELLOW}⚠ DB 파일이 없습니다. 서버를 한 번 실행하면 생성됩니다.${NC}"
    exit 1
  fi

  local ts
  ts=$(date +%Y%m%d_%H%M%S)
  local BACKUP_FILE="$HAN_BACKUP_DIR/han_group_${ts}.db"

  cp "$DB_PATH" "$BACKUP_FILE"

  echo ""
  echo -e "  ${GREEN}✓ 백업 완료${NC}"
  echo "  파일: $BACKUP_FILE"
  echo "  크기: $(du -sh "$BACKUP_FILE" | cut -f1)"
  echo ""

  # 보관 목록 표시
  local COUNT
  COUNT=$(ls "$HAN_BACKUP_DIR"/*.db 2>/dev/null | wc -l | tr -d ' ')
  echo -e "  ${DIM}총 보관된 백업: ${COUNT}개${NC}"
  echo -e "  ${DIM}백업 위치: $HAN_BACKUP_DIR${NC}"
  echo ""
}

# ── han restore ───────────────────────────────────────────────────────────────
cmd_restore() {
  echo ""

  # 백업 목록 로드
  local BACKUPS=()
  while IFS= read -r -d '' f; do
    BACKUPS+=("$f")
  done < <(find "$HAN_BACKUP_DIR" -name "*.db" -print0 2>/dev/null | sort -rz)

  if [ ${#BACKUPS[@]} -eq 0 ]; then
    echo -e "${YELLOW}⚠ 저장된 백업이 없습니다.${NC}"
    echo "  'han backup' 으로 먼저 백업을 생성하세요."
    exit 1
  fi

  echo -e "${BOLD}저장된 백업 목록${NC}"
  echo ""

  local i=1
  for f in "${BACKUPS[@]}"; do
    local fname size mtime
    fname=$(basename "$f")
    size=$(du -sh "$f" 2>/dev/null | cut -f1)
    mtime=$(date -r "$f" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || stat -c "%y" "$f" 2>/dev/null | cut -d. -f1)
    echo "  $i) $fname  [$size]  $mtime"
    ((i++))
  done

  echo ""
  read -r -p "  복원할 번호를 선택하세요 (1-${#BACKUPS[@]}, 취소: q) > " CHOICE

  if [[ "$CHOICE" == "q" || -z "$CHOICE" ]]; then
    echo "  취소됩니다."
    exit 0
  fi

  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt ${#BACKUPS[@]} ]; then
    echo -e "${RED}✗ 잘못된 번호입니다.${NC}"
    exit 1
  fi

  local SELECTED="${BACKUPS[$((CHOICE-1))]}"
  echo ""
  echo -e "${YELLOW}⚠ 현재 DB를 '$(basename "$SELECTED")'으로 교체합니다.${NC}"
  read -r -p "  계속하시겠습니까? (y/N) > " CONFIRM
  if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "  취소됩니다."
    exit 0
  fi

  cmd_stop 2>/dev/null || true

  local DB_PATH="$HAN_DIR/backend/han_group.db"

  # 현재 DB 임시 백업
  if [ -f "$DB_PATH" ]; then
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    cp "$DB_PATH" "$HAN_BACKUP_DIR/han_group_before_restore_${ts}.db"
    echo -e "  ${GREEN}✓ 현재 DB 임시 백업됨 (before_restore_${ts}.db)${NC}"
  fi

  cp "$SELECTED" "$DB_PATH"
  echo -e "  ${GREEN}✓ 복원 완료: $(basename "$SELECTED")${NC}"
  echo ""

  read -r -p "  지금 바로 서버를 시작하시겠습니까? (Y/n) > " START_NOW
  START_NOW="${START_NOW:-Y}"
  if [[ "$START_NOW" =~ ^[Yy]$ ]]; then
    cmd_start "--daemon"
  fi
}

# ── han config ────────────────────────────────────────────────────────────────
cmd_config() {
  local ENV_FILE="$HAN_DIR/backend/.env"
  if [ -f "$ENV_FILE" ]; then
    echo ""
    echo -e "${BOLD}현재 설정 ($ENV_FILE)${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    while IFS= read -r line; do
      if [[ "$line" =~ _API_KEY= ]] && [[ ! "$line" =~ =$ ]]; then
        local key="${line%%=*}"
        local val="${line##*=}"
        local masked="${val:0:8}****${val: -4}"
        echo "  $key=$masked"
      else
        echo "  $line"
      fi
    done < "$ENV_FILE"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "  수정: nano $ENV_FILE"
    echo "  수정 후 'han restart' 로 재시작하세요."
    echo ""
  else
    echo -e "${YELLOW}⚠ .env 없음. 'han start' 로 먼저 실행하세요.${NC}"
  fi
}

# ── han open ──────────────────────────────────────────────────────────────────
cmd_open() {
  local URL="http://localhost:5173"
  if command -v xdg-open &>/dev/null; then xdg-open "$URL"
  elif command -v open &>/dev/null; then open "$URL"
  else echo "브라우저에서 직접 접속하세요: $URL"
  fi
}

# ── 명령 라우팅 ───────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  start)                cmd_start "$@" ;;
  stop)                 cmd_stop ;;
  restart)              cmd_restart ;;
  status)               cmd_status ;;
  logs)                 cmd_logs "$@" ;;
  init_check|doctor)    cmd_init_check ;;
  update)               cmd_update ;;
  reset)                cmd_reset ;;
  backup)               cmd_backup ;;
  restore)              cmd_restore ;;
  config)               cmd_config ;;
  open)                 cmd_open ;;
  --version|-v)         cmd_version ;;
  help|--help|-h)       cmd_help ;;
  *)
    echo -e "${RED}알 수 없는 명령: $COMMAND${NC}"
    echo "  'han help' 로 사용법을 확인하세요."
    exit 1
    ;;
esac
