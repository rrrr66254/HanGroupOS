}

# ── han --version ─────────────────────────────────────────────────────────────
cmd_version() {
  echo "han v${HAN_VERSION} — HAN Group OS CLI"
  echo "설치 경로: $HAN_DIR"
  if command -v git &>/dev/null && [ -d "$HAN_DIR/.git" ]; then
    local commit
    commit=$(git -C "$HAN_DIR" rev-parse --short HEAD 2>/dev/null || echo "알 수 없음")
    echo "커밋: $commit"
  fi
}

# ── han init_check ────────────────────────────────────────────────────────────
cmd_init_check() {
  local FIX=false
  [[ "${1:-}" == "--fix" ]] && FIX=true
  local FAIL=0
  local WARN=0
  local PASS=0

  # 헬퍼: 체크 결과 출력 + 카운터
  # ※ ((N++)) 는 N=0일 때 exit status 1 → set -e로 스크립트 종료됨
  #    → 반드시 PASS=$((PASS+1)) 형태 사용
  _ok()   { echo -e "  ${GREEN}✓${NC} $*"; PASS=$((PASS+1)); }
  _warn() { echo -e "  ${YELLOW}△${NC} $*"; WARN=$((WARN+1)); }
  _fail() { echo -e "  ${RED}✗${NC} $*"; FAIL=$((FAIL+1)); }

  echo ""
  echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${BOLD}║     han init_check — 환경 사전 점검          ║${NC}"
  echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
  echo ""

  # ─ 섹션 1: 필수 프로그램 ───────────────────────────────────────────────────
  echo -e "${BOLD}[ 1/4 ] 필수 프로그램${NC}"
  echo ""

  # Python
  local py_ok=false
  if command -v python3 &>/dev/null; then
    local py_ver py_major py_minor
    py_ver=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    py_major=$(python3 -c "import sys; print(sys.version_info.major)")
    py_minor=$(python3 -c "import sys; print(sys.version_info.minor)")
    if [[ $py_major -ge 3 && $py_minor -ge 9 ]]; then
      _ok "Python $py_ver"
      py_ok=true
    else
      _fail "Python $py_ver  (3.9 이상 필요)"
      echo ""
      _install_guide_python
    fi
  else
    _fail "Python3 미설치"
    echo ""
    _install_guide_python
  fi

  # pip
  if $py_ok; then
    if python3 -m pip --version &>/dev/null 2>&1; then
      local pip_ver
      pip_ver=$(python3 -m pip --version | awk '{print $2}')
      _ok "pip $pip_ver"
    else
      _fail "pip 미설치"
      echo ""
      _install_guide_pip
    fi
  fi

  # Node.js
  local node_ok=false
  if command -v node &>/dev/null; then
    local node_ver node_major
    node_ver=$(node -v | sed 's/v//')
    node_major=$(echo "$node_ver" | cut -d. -f1)
    if [[ $node_major -ge 18 ]]; then
      _ok "Node.js v$node_ver"
      node_ok=true
    else
      _fail "Node.js v$node_ver  (v18 이상 필요)"
      echo ""
      _install_guide_node
    fi
  else
    _fail "Node.js 미설치"
    echo ""
    _install_guide_node
  fi

  # npm
  if $node_ok; then
    if command -v npm &>/dev/null; then
      local npm_ver
      npm_ver=$(npm --version)
      _ok "npm $npm_ver"
    else
      _fail "npm 미설치  →  Node.js 재설치 필요"
    fi
  fi

  # git
  if command -v git &>/dev/null; then
    local git_ver
    git_ver=$(git --version | awk '{print $3}')
    _ok "git $git_ver"
  else
    _warn "git 미설치  (han update 명령에 필요)"
    echo ""
    case $OS in
      macos)     echo "       brew install git" ;;
      wsl|linux) echo "       sudo apt install -y git" ;;
      *)         echo "       https://git-scm.com/downloads" ;;
    esac
    echo ""
  fi

  # ─ 섹션 2: 포트 가용성 ────────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}[ 2/4 ] 포트 가용성${NC}"
  echo ""

  for PORT in 8000 5173; do
    local role
    [[ $PORT -eq 8000 ]] && role="백엔드" || role="프론트엔드"
    if port_in_use "$PORT"; then
      local proc=""
      if command -v lsof &>/dev/null; then
        proc=$(lsof -ti:"$PORT" 2>/dev/null | head -1 | xargs -I{} ps -p {} -o comm= 2>/dev/null || true)
      fi
      _warn "포트 $PORT ($role) 이미 사용 중${proc:+ — $proc}"
      echo ""
      echo "       수정 방법:"
      case $OS in
        macos)     echo "         kill -9 \$(lsof -ti:$PORT)" ;;
        wsl|linux) echo "         fuser -k ${PORT}/tcp" ;;
        *)         echo "         han stop  (HAN 서버라면)" ;;
      esac
      echo ""
    else
      _ok "포트 $PORT ($role) 사용 가능"
    fi
  done

  # ─ 섹션 3: 설정 파일 ──────────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}[ 3/4 ] 설정 파일${NC}"
  echo ""

  local env_file="$HAN_DIR/backend/.env"
  if [ -f "$env_file" ]; then
    _ok ".env 존재"
    local provider
    provider=$(grep "^DEFAULT_PROVIDER=" "$env_file" | cut -d= -f2)
    _ok "AI 프로바이더: ${provider:-미설정}"

    # Ollama 연결 확인
    if [[ "$provider" == "ollama" ]]; then
      local ollama_url
      ollama_url=$(grep "^OLLAMA_BASE_URL=" "$env_file" | cut -d= -f2)
      ollama_url="${ollama_url:-http://localhost:11434}"
      if curl -sf --max-time 2 "$ollama_url/api/tags" &>/dev/null; then
        _ok "Ollama 서버 응답 중 ($ollama_url)"
      else
        _fail "Ollama 서버 응답 없음 ($ollama_url)"
        echo ""
        echo "       수정 방법:"
        echo "         ollama serve                # 실행 (이미 설치된 경우)"
        echo "         https://ollama.com/download # 미설치 시"
        echo ""
      fi
    fi

    # API 키 확인
    for KEY_NAME in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY; do
      local key_val
      key_val=$(grep "^${KEY_NAME}=" "$env_file" | cut -d= -f2)
      if [[ -n "$key_val" ]]; then
        _ok "${KEY_NAME} 설정됨 (${key_val:0:8}****)"
      fi
    done
  else
    _warn ".env 없음"
    echo ""
    echo "       수정 방법:"
    echo "         han init_check --fix  # 기본 .env 자동 생성"
    echo "         han start             # 또는 서버 시작 시 자동 생성"
    echo ""
  fi

  # ─ 섹션 4: 프로젝트 파일 ─────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}[ 4/4 ] 프로젝트 파일 & 의존성${NC}"
  echo ""

  local checks=(
    "$HAN_DIR/backend/main.py:FastAPI 진입점"
    "$HAN_DIR/backend/requirements.txt:Python 의존성 목록"
    "$HAN_DIR/frontend/package.json:Node.js 패키지 정의"
    "$HAN_DIR/start.sh:실행 스크립트"
  )
  for entry in "${checks[@]}"; do
    local path="${entry%%:*}"
    local label="${entry##*:}"
    if [ -f "$path" ]; then
      _ok "$label"
    else
      _fail "$label 없음  ($path)"
      echo "       수정: han update  또는 재설치"
    fi
  done

  # venv 체크
  if [ -d "$HAN_DIR/backend/venv" ]; then
    _ok "Python 가상환경 (backend/venv)"
  else
    _warn "Python 가상환경 없음"
    echo "       수정: han init_check --fix  또는 han start"
  fi

  # node_modules 체크
  if [ -d "$HAN_DIR/frontend/node_modules" ]; then
    _ok "node_modules 설치됨"
  else
    _warn "node_modules 없음"
    echo "       수정: han init_check --fix  또는 han start"
  fi

  # ─ --fix: venv 생성, pip install, npm install, .env 생성 ────────────────
  if $FIX && [[ $FAIL -gt 0 || $WARN -gt 0 || ! -d "$HAN_DIR/backend/venv" || ! -d "$HAN_DIR/frontend/node_modules" || ! -f "$HAN_DIR/backend/.env" ]]; then
    echo ""
    echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}║     자동 수정 진행 중...                     ║${NC}"
    echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
    echo ""
    FAIL=0; WARN=0; PASS=0

    # venv 생성
    if [ ! -d "$HAN_DIR/backend/venv" ] && command -v python3 &>/dev/null; then
      echo -e "  ${CYAN}▸ Python 가상환경 생성 중...${NC}"
      python3 -m venv "$HAN_DIR/backend/venv" \
        && { _ok "venv 생성 완료"; } \
        || { _fail "venv 생성 실패"; }
    fi

    # pip install
    local VENV_PIP="$HAN_DIR/backend/venv/bin/pip"
    if [ -f "$VENV_PIP" ] && [ -f "$HAN_DIR/backend/requirements.txt" ]; then
      if ! "$HAN_DIR/backend/venv/bin/python" -c "import fastapi" 2>/dev/null; then
        echo -e "  ${CYAN}▸ pip install -r requirements.txt ...${NC}"
        "$VENV_PIP" install -q -r "$HAN_DIR/backend/requirements.txt" \
          && { _ok "Python 패키지 설치 완료"; } \
          || { _fail "pip install 실패  →  pip install -r $HAN_DIR/backend/requirements.txt"; }
      else
        _ok "Python 패키지 이미 설치됨"
      fi
    fi

    # npm install
    if [ ! -d "$HAN_DIR/frontend/node_modules" ] && command -v npm &>/dev/null; then
      echo -e "  ${CYAN}▸ npm install 실행 중...${NC}"
      (cd "$HAN_DIR/frontend" && npm install --silent) \
        && { _ok "npm install 완료"; } \
        || { _fail "npm install 실패  →  cd $HAN_DIR/frontend && npm install"; }
    fi

    # .env 생성 또는 신규 키 병합 (기존 값 절대 덮어쓰지 않음)
    echo -e "  ${CYAN}▸ .env 확인 중...${NC}"
    local ENV_DEFAULTS_FIX=(
      "SECRET_KEY=han-group-os-secret-key-change-in-production"
      "DATABASE_URL=sqlite:///./han_group.db"
      "DEFAULT_PROVIDER=mock"
      "ANTHROPIC_API_KEY="
      "OPENAI_API_KEY="
      "GEMINI_API_KEY="
      "OLLAMA_BASE_URL=http://localhost:11434"
      "OLLAMA_MODEL=qwen2.5"
    )
    local ENV_FILE="$HAN_DIR/backend/.env"
    local env_added=0

    if [ ! -f "$ENV_FILE" ]; then
      touch "$ENV_FILE"
      for entry in "${ENV_DEFAULTS_FIX[@]}"; do
        echo "$entry" >> "$ENV_FILE"
      done
      _ok ".env 생성 완료 (han config set으로 API 키를 설정하세요)"
    else
      for entry in "${ENV_DEFAULTS_FIX[@]}"; do
        local K="${entry%%=*}"
        if ! grep -q "^${K}=" "$ENV_FILE" 2>/dev/null; then
          echo "$entry" >> "$ENV_FILE"
          env_added=$((env_added+1))
          echo -e "  ${CYAN}    + 새 키 추가: ${K}${NC}"
        fi
      done
      if [ "$env_added" -eq 0 ]; then
        _ok ".env 최신 상태 (기존 설정 보존)"
      else
        _ok ".env 에 ${env_added}개 새 키 추가됨 (기존 값 보존)"
      fi
    fi
    echo ""
  fi

  # ─ 요약 박스 ─────────────────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}┌──────────────────────────────────────────────┐${NC}"
  echo -e "${BOLD}│  점검 결과 요약                              │${NC}"
  echo -e "${BOLD}├──────────────────────────────────────────────┤${NC}"
  echo -e "  ${GREEN}✓ 통과  : ${PASS}개${NC}"
  echo -e "  ${YELLOW}△ 경고  : ${WARN}개${NC}"
  echo -e "  ${RED}✗ 실패  : ${FAIL}개${NC}"
  echo -e "${BOLD}└──────────────────────────────────────────────┘${NC}"
  echo ""
  if [[ $FAIL -eq 0 && $WARN -eq 0 ]]; then
    echo -e "  ${GREEN}✅ 완벽합니다! 'han start' 로 서버를 시작하세요.${NC}"
  elif [[ $FAIL -eq 0 ]]; then
    echo -e "  ${YELLOW}⚠  경고 항목이 있습니다. 'han start' 는 가능합니다.${NC}"
    $FIX || echo -e "     자동 수정: ${CYAN}han init_check --fix${NC}"
  else
    echo -e "  ${RED}✗  실패 항목을 수정 후 재실행하세요.${NC}"
    $FIX || echo -e "     자동 수정: ${CYAN}han init_check --fix${NC}"
  fi
  echo ""

  return $FAIL
}

# ── 설치 가이드 서브함수 ───────────────────────────────────────────────────────
_install_guide_python() {
  echo -e "  ${YELLOW}▶ Python 3.11 설치 방법:${NC}"
  case $OS in
    macos)
      echo "    # Homebrew가 없다면:"
      echo "    /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
      echo "    # Python 설치:"
      echo "    brew install python@3.11"
      ;;
    wsl|linux)
      echo "    sudo apt update"
      echo "    sudo apt install -y python3.11 python3.11-venv python3-pip"
      ;;
    *)
      echo "    1. https://www.python.org/downloads/ 접속"
      echo "    2. Python 3.11.x 다운로드 및 설치"
      echo "    3. ☑ 'Add Python to PATH' 반드시 체크"
      ;;
  esac
  echo ""
}

_install_guide_pip() {
  echo -e "  ${YELLOW}▶ pip 설치 방법:${NC}"
  case $OS in
    wsl|linux) echo "    sudo apt install -y python3-pip" ;;
    *)         echo "    python3 -m ensurepip --upgrade" ;;
  esac
  echo ""
}

_install_guide_node() {
